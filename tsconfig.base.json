{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@prisma/client": ["./prisma/generated/client"],
      "@ember/contracts": ["./packages/contracts/src/index.ts"],
      "@ember/event-bus": ["./packages/event-bus/src/index.ts"],
      "@ember/observability": ["./packages/observability/src/index.ts"],
      "@ember/observability/tracing": ["./packages/observability/src/tracing.ts"],
      "@ember/core": ["./packages/core/index.ts"],
      "@ember/sdk": ["./packages/sdk/src/index.ts"],
      "@ember/sharding": ["./packages/sharding/src/index.ts"],
      "@ember/worker/main": ["./apps/worker/src/main.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "preserveConstEnums": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": false,
    "incremental": false,
    "noEmit": true
  }
}
