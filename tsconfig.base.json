{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["bun"],
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["bun", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "preserveConstEnums": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@lumi/*.js": ["./src/*.ts"],
      "@lumi/*": ["./src/*"],
      "@lib/*.js": ["./src/lib/*.ts"],
      "@lib/*": ["./src/lib/*"],
      "@modules/*.js": ["./src/modules/*.ts"],
      "@modules/*": ["./src/modules/*"],
      "@contracts/*.js": ["./src/contracts/*.ts"],
      "@contracts/*": ["./src/contracts/*"],
      "@observability/*.js": ["./src/observability/*.ts"],
      "@observability/*": ["./src/observability/*"],
      "@shared/*.js": ["./src/shared/*.ts"],
      "@shared/*": ["./src/shared/*"],
      "@cli/*.js": ["./src/cli/*.ts"],
      "@cli/*": ["./src/cli/*"],
      "@scripts/*.js": ["./src/scripts/*.ts"],
      "@scripts/*": ["./src/scripts/*"],
      "@languages/*.js": ["./src/languages/*.ts"],
      "@languages/*": ["./src/languages/*"],
      "@api/*.js": ["./src/lib/api/*.ts"],
      "@api/*": ["./src/lib/api/*"],
      "@cache/*.js": ["./src/lib/cache/*.ts"],
      "@cache/*": ["./src/lib/cache/*"],
      "@redis/*.js": ["./src/lib/redis/*.ts"],
      "@redis/*": ["./src/lib/redis/*"],
      "@db/*.js": ["./src/lib/prisma/*.ts"],
      "@db/*": ["./src/lib/prisma/*"],
      "@rpc/*.js": ["./src/lib/rpc/*.ts"],
      "@rpc/*": ["./src/lib/rpc/*"],
      "@ui/*.js": ["./src/lib/ui/*.ts"],
      "@ui/*": ["./src/lib/ui/*"],
      "@commands/*.js": ["./src/lib/commands/*.ts"],
      "@commands/*": ["./src/lib/commands/*"],
      "@listeners/*.js": ["./src/lib/listeners/*.ts"],
      "@listeners/*": ["./src/lib/listeners/*"],
      "@interactions/*.js": ["./src/lib/interactions/*.ts"],
      "@interactions/*": ["./src/lib/interactions/*"],
      "@module-system/*.js": ["./src/lib/module-system/*.ts"],
      "@module-system/*": ["./src/lib/module-system/*"],
      "@utilities/*.js": ["./src/lib/utilities/*.ts"],
      "@utilities/*": ["./src/lib/utilities/*"],
      "@i18n/*.js": ["./src/lib/i18n/*.ts"],
      "@i18n/*": ["./src/lib/i18n/*"],
      "@scheduler/*.js": ["./src/lib/scheduler/*.ts"],
      "@scheduler/*": ["./src/lib/scheduler/*"],
      "@downloader/*.js": ["./src/lib/downloader/*.ts"],
      "@downloader/*": ["./src/lib/downloader/*"],
      "@discord/*.js": ["./src/lib/discord/*.ts"],
      "@discord/*": ["./src/lib/discord/*"],
      "@event-bus/*.js": ["./src/lib/event-bus/*.ts"],
      "@event-bus/*": ["./src/lib/event-bus/*"],
      "@lumi/module": ["./src/lib/module-system/Module.ts"],
      "@lumi/module.js": ["./src/lib/module-system/Module.ts"],
      "@lumi/commands": ["./src/lib/commands/CommandDef.ts"],
      "@lumi/commands.js": ["./src/lib/commands/CommandDef.ts"],
      "@lumi/context": ["./src/lib/commands/Context.ts"],
      "@lumi/context.js": ["./src/lib/commands/Context.ts"],
      "@lumi/listeners": ["./src/lib/listeners/ListenerDef.ts"],
      "@lumi/listeners.js": ["./src/lib/listeners/ListenerDef.ts"],
      "@lumi/interactions": ["./src/lib/interactions/InteractionDef.ts"],
      "@lumi/interactions.js": ["./src/lib/interactions/InteractionDef.ts"],
      "@lumi/ui": ["./src/lib/ui/Cards.ts"],
      "@lumi/ui.js": ["./src/lib/ui/Cards.ts"],
      "@lumi/config": ["./src/lib/module-system/ConfigSchema.ts"],
      "@lumi/config.js": ["./src/lib/module-system/ConfigSchema.ts"],
      "@lumi/gdpr": ["./src/lib/gdpr/ModuleGdpr.ts"],
      "@lumi/gdpr.js": ["./src/lib/gdpr/ModuleGdpr.ts"],
      "@lumi/seal": ["./src/lib/crypto/Seal.ts"],
      "@lumi/seal.js": ["./src/lib/crypto/Seal.ts"],
      "@lumi/services": ["./src/lib/Services.ts"],
      "@lumi/services.js": ["./src/lib/Services.ts"],
      "@lumi/scheduler": ["./src/lib/scheduler/Oneshot.ts"],
      "@lumi/scheduler.js": ["./src/lib/scheduler/Oneshot.ts"],
      "@lumi/bank": ["./src/lib/api/economy/Bank.ts"],
      "@lumi/bank.js": ["./src/lib/api/economy/Bank.ts"],
      "@lumi/time": ["./src/lib/utilities/Time.ts"],
      "@lumi/time.js": ["./src/lib/utilities/Time.ts"],
      "@lumi/panels": ["./src/lib/ui/Panels.ts"],
      "@lumi/panels.js": ["./src/lib/ui/Panels.ts"],
      "@lumi/cooldown": ["./src/lib/redis/Cooldown.ts"],
      "@lumi/cooldown.js": ["./src/lib/redis/Cooldown.ts"]
    }
  }
}
