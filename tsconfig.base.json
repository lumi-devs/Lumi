{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["bun", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "preserveConstEnums": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@lumi/contracts": ["./packages/contracts/src/index.ts"],
      "@lumi/observability": ["./packages/observability/src/index.ts"],
      "@lumi/observability/tracing": ["./packages/observability/src/tracing.ts"],
      "@lumi/core": ["./packages/core/index.ts"],
      "@lumi/core/setup": ["./packages/core/src/lib/client/setup.ts"],
      "#lib/env.js": ["./packages/core/src/lib/env.ts"],
      "#lib/*.js": ["./packages/core/src/lib/*.ts"]
    }
  }
}
