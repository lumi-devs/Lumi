{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["bun"],
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["bun", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "preserveConstEnums": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@lumi/contracts": ["./packages/contracts/src/index.ts"],
      "@lumi/contracts/views": ["./packages/contracts/src/views.ts"],
      "@lumi/contracts/rpc": ["./packages/contracts/src/rpc/index.ts"],
      "@lumi/contracts/events": ["./packages/contracts/src/events.ts"],
      "@lumi/observability": ["./packages/observability/src/index.ts"],
      "@lumi/observability/tracing": ["./packages/observability/src/tracing.ts"],
      "@lumi/core": ["./packages/core/index.ts"],
      "@lumi/core/setup": ["./packages/core/src/lib/client/setup.ts"],
      "@lumi/application": ["./packages/application/src/index.ts"],
      "@lumi/application/*": ["./packages/application/src/*"],
      "@lumi/infrastructure": ["./packages/infrastructure/src/index.ts"],
      "@lumi/infrastructure/database": ["./packages/infrastructure/src/database/index.ts"],
      "@lumi/infrastructure/cache": ["./packages/infrastructure/src/cache/index.ts"],
      "@lumi/infrastructure/queues": ["./packages/infrastructure/src/queues/index.ts"],
      "@lumi/infrastructure/services": ["./packages/infrastructure/src/services/index.ts"],
      "@lumi/infrastructure/*": ["./packages/infrastructure/src/*"],
      "#modules/*.js": ["./packages/core/src/modules/*.ts"],
      "#lib/env.js": ["./packages/core/src/lib/env.ts"],
      "#lib/*.js": ["./packages/core/src/lib/*.ts"]
    }
  }
}
