// Lumi — Prisma schema
// Single file, partitioned by domain. Module-owned tables live alongside the
// module section that owns them; only Core types live in the Core section.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  engineType      = "library"
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum PermitKind {
  enforced
  custom
}

enum PermitPolarity {
  grant
  deny
}

enum PermitTargetType {
  user
  role
  channel
}

/// Shared by ModerationCase.action and WarnThreshold.action. "voice_mute" is
/// the vcmute action's real name (the module command is called vcmute, the
/// case/threshold action is not — keep them distinct).
enum CaseAction {
  ban
  unban
  kick
  mute
  unmute
  softban
  voice_mute
  unvoice_mute
  warn
  quarantine
  unquarantine
  antinuke_alert
}

enum AppealStatus {
  pending
  approved
  denied
  denied_blacklisted
  dismissed
}

enum OverrideTargetType {
  channel
  category
  role
  user
}

enum AuditPlatform {
  discord
  web
}

enum EconomyTxnKind {
  deposit
  withdraw
  transfer_out
  transfer_in
  slots_bid
  slots_win
  payday
  admin_add
  admin_remove
  admin_set
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE — global + guild config, permissions, moderation, blocklist, ignore
// ─────────────────────────────────────────────────────────────────────────────

model Global {
  id                        Int       @id @default(1)
  botName                   String    @default("Lumi") @map("bot_name") @db.VarChar(64)
  defaultPrefix             String    @default(",") @map("default_prefix") @db.VarChar(5)
  maintenanceMode           Boolean   @default(false) @map("maintenance_mode")
  maintenanceMessage        String?   @map("maintenance_message") @db.VarChar(500)
  inviteUrl                 String?   @map("invite_url") @db.VarChar(200)
  supportGuildId            String?   @map("support_guild_id") @db.VarChar(20)
  serverLockEnabled         Boolean   @default(false) @map("server_lock_enabled")
  serverLockGuildIds        String[]  @map("server_lock_guild_ids")
  autoUpdateEnabled         Boolean   @default(false) @map("auto_update_enabled")
  autoUpdateIntervalMinutes Int       @default(360) @map("auto_update_interval_minutes")
  autoUpdateLastCheckedAt   DateTime? @map("auto_update_last_checked_at")
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("global_config")
}

model GlobalModuleState {
  moduleName String   @id @map("module_name") @db.VarChar(64)
  enabled    Boolean  @default(true)
  reason     String?  @db.VarChar(200)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("global_module_state")
}

model Guild {
  id        String    @id @map("guild_id") @db.VarChar(20)
  prefix    String?   @db.VarChar(5)
  locale    String    @default("en-US") @db.VarChar(10)
  ignored   Boolean   @default(false)
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  moduleStates      GuildModuleState[]
  moduleConfigs     GuildModuleConfig[]
  moduleData        ModuleData[]
  permits           Permit[]
  permitAssignments PermitAssignment[]
  cases             ModerationCase[]
  caseCounter       GuildCaseCounter?
  modNotes          ModNote[]
  appeals           Appeal[]
  afkEntries        AfkEntry[]
  ignoreEntries     IgnoreEntry[]
  auditLedgers      AuditLedger[]
  warnThresholds    WarnThreshold[]
  panicState        PanicState?
  verificationPanel VerificationPanel?
  backups           GuildBackup[]
  tempVcGenerators  TempVcGenerator[]
  tempVcRecords     TempVcRecord[]
  blocklistEntries  Blocklist[]
  configHistory     ModuleConfigHistory[]
  configOverrides   ModuleConfigOverride[]
  economyAccounts   EconomyAccount[]
  economyTxns       EconomyTransaction[]
  reactionRoleMenus ReactionRoleMenu[]
  stickyMessages    StickyMessage[]

  @@index([leftAt])
  @@map("guilds")
}

model GuildModuleState {
  guildId    String   @map("guild_id") @db.VarChar(20)
  moduleName String   @map("module_name") @db.VarChar(64)
  enabled    Boolean  @default(true)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleName])
  @@index([moduleName])
  @@map("guild_module_state")
}

model GuildModuleConfig {
  guildId    String   @map("guild_id") @db.VarChar(20)
  moduleName String   @map("module_name") @db.VarChar(64)
  configKey  String   @map("config_key") @db.VarChar(64)
  value      Json     @map("value_json")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleName, configKey])
  @@map("guild_module_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// PERMITS (Wick-style Permit System)
// ─────────────────────────────────────────────────────────────────────────────

/// A named, reusable bundle of permit nodes. "enforced" permits are the two
/// fixed, non-deletable, user-assignable tiers (immune to Anti-Nuke Quarantine);
/// "custom" permits are admin-defined, role-assignable, fully editable bundles.
model Permit {
  id        Int            @id @default(autoincrement())
  guildId   String         @map("guild_id") @db.VarChar(20)
  name      String         @db.VarChar(64)
  kind      PermitKind
  polarity  PermitPolarity @default(grant)
  nodes     String[]       @map("nodes")
  builtin   Boolean        @default(false)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")

  guild       Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  assignments PermitAssignment[]

  @@unique([guildId, name], name: "uq_permit_guild_name")
  @@index([guildId, kind])
  @@map("permits")
}

/// Assigns a Permit to a user, role, or channel. Enforced permits only ever
/// have targetType=user rows; custom permits may have targetType=user,
/// role, or channel rows — enforced at the service layer (see
/// KindTargetTypes in PermissionRepository.ts), not by a DB constraint.
model PermitAssignment {
  id         Int              @id @default(autoincrement())
  permitId   Int              @map("permit_id")
  guildId    String           @map("guild_id") @db.VarChar(20)
  targetType PermitTargetType @map("target_type")
  targetId   String           @map("target_id") @db.VarChar(20)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at")

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([permitId, targetType, targetId], name: "uq_permit_assignment")
  @@index([guildId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("permit_assignments")
}

// Atomic per-guild case-number counter to avoid duplicate caseNumber races.
model GuildCaseCounter {
  guildId String @id @map("guild_id") @db.VarChar(20)
  next    Int    @default(1)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("guild_case_counter")
}

model ModerationCase {
  id          Int        @id @default(autoincrement())
  guildId     String     @map("guild_id") @db.VarChar(20)
  caseNumber  Int        @map("case_number")
  userId      String     @map("user_id") @db.VarChar(20) // '0' = anonymized (GDPR)
  moderatorId String     @map("moderator_id") @db.VarChar(20) // '0' = anonymized (GDPR)
  action      CaseAction
  reason      String?    @db.VarChar(1000)
  duration    Int?       @map("duration_seconds")
  expiresAt   DateTime?  @map("expires_at")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")

  guild  Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  appeal Appeal?

  @@unique([guildId, caseNumber], name: "uq_cases_guild_number")
  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@index([guildId, moderatorId])
  @@index([guildId, action])
  @@index([userId])
  @@index([moderatorId]) // GDPR anonymization + cross-guild moderator lookups
  @@index([guildId, active, expiresAt]) // per-guild expiry sweep
  // The startup re-arm and warn decay sweep every guild at once, so they cannot
  // use any guildId-leading index. Both paginate on id, so id is part of the
  // index: without it Postgres index-scans and then sorts every matching row
  // just to take one page.
  @@index([active, id])
  @@index([action, active, id])
  @@map("moderation_cases")
}

// Ban/timeout appeal, submitted through a signed link DMed to the punished
// user on punishment (see packages/core/src/lib/appeals/token.ts). One
// appeal per case - a case that already has one is not appealable again.
model Appeal {
  id         Int          @id @default(autoincrement())
  guildId    String       @map("guild_id") @db.VarChar(20)
  userId     String       @map("user_id") @db.VarChar(20)
  caseId     Int          @unique @map("case_id")
  status     AppealStatus @default(pending)
  message    String       @db.VarChar(2000)
  reviewedBy String?      @map("reviewed_by") @db.VarChar(20)
  reviewedAt DateTime?    @map("reviewed_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  guild Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  case  ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
  @@index([guildId, createdAt])
  @@index([userId])
  @@index([reviewedBy])
  @@map("appeals")
}

// Persistent staff-only note on a member, separate from warns/cases - never
// shown to the member and not counted toward warn thresholds.
model ModNote {
  id        Int      @id @default(autoincrement())
  guildId   String   @map("guild_id") @db.VarChar(20)
  userId    String   @map("user_id") @db.VarChar(20)
  authorId  String   @map("author_id") @db.VarChar(20)
  message   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, createdAt])
  @@index([userId])
  @@index([authorId])
  @@map("mod_notes")
}

// Global blocklist: keyed on the user, no guild scope at all.
model GlobalBlock {
  userId    String   @id @map("user_id") @db.VarChar(20)
  reason    String?  @db.VarChar(500)
  blockedBy String   @map("blocked_by") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([blockedBy])
  @@map("global_blocklist")
}

model Blocklist {
  id        Int      @id @default(autoincrement())
  guildId   String   @map("guild_id") @db.VarChar(20)
  userId    String   @map("user_id") @db.VarChar(20)
  reason    String?  @db.VarChar(500)
  blockedBy String   @map("blocked_by") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId], name: "uq_blocklist_user_guild")
  @@index([guildId, createdAt])
  @@index([blockedBy])
  @@map("blocklist")
}

// Whole-guild ignore is Guild.ignored; every row here is one ignored channel.
model IgnoreEntry {
  id        Int      @id @default(autoincrement())
  guildId   String   @map("guild_id") @db.VarChar(20)
  channelId String   @map("channel_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId], name: "uq_ignore_guild_channel")
  @@index([guildId])
  @@map("ignore_list")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: afk
// ─────────────────────────────────────────────────────────────────────────────

model AfkEntry {
  userId  String   @map("user_id") @db.VarChar(20)
  guildId String   @map("guild_id") @db.VarChar(20)
  reason  String   @default("AFK") @db.VarChar(100)
  since   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([userId, guildId])
  // userId is already the PK's leading column; guildId is not, so per-guild
  // reads need their own index.
  @@index([guildId])
  @@map("afk_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: downloader
// ─────────────────────────────────────────────────────────────────────────────

model DownloaderRepo {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(64)
  url       String   @db.VarChar(200)
  branch    String   @default("master") @db.VarChar(64)
  commit    String?  @db.VarChar(40) // Pinned commit hash
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  installedModules DownloaderModule[]

  @@map("downloader_repos")
}

model DownloaderModule {
  repoId      Int      @map("repo_id")
  moduleName  String   @map("module_name") @db.VarChar(64)
  version     String?  @db.VarChar(32)
  commit      String?  @db.VarChar(40) // Commit at time of install
  pinned      Boolean  @default(false) // Frozen against ,module update / updateall
  installedAt DateTime @default(now()) @map("installed_at")

  repo DownloaderRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@id([repoId, moduleName])
  @@index([moduleName])
  @@map("downloader_modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LEDGER
// ─────────────────────────────────────────────────────────────────────────────

model AuditLedger {
  id        Int           @id @default(autoincrement())
  guildId   String        @map("guild_id") @db.VarChar(20)
  userId    String        @map("user_id") @db.VarChar(20)
  action    String        @db.VarChar(128)
  platform  AuditPlatform
  details   Json?
  createdAt DateTime      @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, userId])
  @@index([createdAt])
  // GDPR delete/export filter on userId across every guild.
  @@index([userId])
  @@map("audit_ledger")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE DATA (KV STORE)
// ─────────────────────────────────────────────────────────────────────────────

model ModuleData {
  guildId    String @map("guild_id") @db.VarChar(20)
  moduleName String @map("module_name") @db.VarChar(64)
  targetId   String @map("target_id") @db.VarChar(191) // User/Channel ID, 'global', or a module-defined key (prefixed id, author hash, …)
  key        String @db.VarChar(64)
  value      Json // The dynamic payload

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleName, targetId, key])
  @@index([moduleName, key])
  @@index([targetId])
  @@map("module_dynamic_data")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONFIG HISTORY (#10)
// ─────────────────────────────────────────────────────────────────────────────

model ModuleConfigHistory {
  id         Int      @id @default(autoincrement())
  guildId    String   @map("guild_id") @db.VarChar(20)
  moduleName String   @map("module_name") @db.VarChar(64)
  key        String   @db.VarChar(64)
  oldValue   Json?    @map("old_value")
  newValue   Json     @map("new_value")
  actorId    String   @map("actor_id") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, moduleName, createdAt])
  @@index([actorId])
  @@map("module_config_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONFIG OVERRIDES (#11)
// ─────────────────────────────────────────────────────────────────────────────

model ModuleConfigOverride {
  id         Int                @id @default(autoincrement())
  guildId    String             @map("guild_id") @db.VarChar(20)
  moduleName String             @map("module_name") @db.VarChar(64)
  key        String             @db.VarChar(64)
  modelType  OverrideTargetType @map("model_type")
  modelId    String             @map("model_id") @db.VarChar(20)
  value      Json

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, moduleName, key, modelType, modelId], name: "uq_config_override")
  @@index([guildId, moduleName])
  @@index([modelId])
  @@map("module_config_overrides")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: mod (Warn Threshold Rules)
// ─────────────────────────────────────────────────────────────────────────────

model WarnThreshold {
  guildId   String     @map("guild_id") @db.VarChar(20)
  warnCount Int        @map("warn_count")
  action    CaseAction
  duration  Int?       @map("duration_seconds")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, warnCount])
  @@map("warn_thresholds")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: security (Panic Mode & Verification)
// ─────────────────────────────────────────────────────────────────────────────

model PanicState {
  guildId        String   @id @map("guild_id") @db.VarChar(20)
  actorId        String   @map("actor_id") @db.VarChar(20)
  invitesPaused  Boolean  @default(false) @map("invites_paused")
  lockedChannels Json     @map("locked_channels") // channelId -> prior @everyone SendMessages allow state (true | false | null)
  startedAt      DateTime @default(now()) @map("started_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@map("panic_states")
}

model VerificationPanel {
  guildId   String   @id @map("guild_id") @db.VarChar(20)
  channelId String   @map("channel_id") @db.VarChar(20)
  messageId String   @map("message_id") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("verification_panels")
}

// Structural snapshot for the anti-nuke Restore System - roles and channels
// only, never messages or member role assignments (matches Wick's documented
// scope). `data` shape: { roles: RoleSnapshot[], channels: ChannelSnapshot[] }.
model GuildBackup {
  id        Int      @id @default(autoincrement())
  guildId   String   @map("guild_id") @db.VarChar(20)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("guild_backups")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: tempvc (Temporary Voice Channels)
// ─────────────────────────────────────────────────────────────────────────────

model TempVcGenerator {
  guildId   String @map("guild_id") @db.VarChar(20)
  channelId String @map("channel_id") @db.VarChar(20)
  name      String @db.VarChar(100) // Name template; "{}" is the number slot.
  limit     Int    @default(0) // User limit for created channels (0 = unlimited).

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId])
  @@map("tempvc_generators")
}

model TempVcRecord {
  guildId     String   @map("guild_id") @db.VarChar(20)
  channelId   String   @map("channel_id") @db.VarChar(20)
  ownerId     String   @map("owner_id") @db.VarChar(20)
  generatorId String   @map("generator_id") @db.VarChar(20)
  name        String   @db.VarChar(100)
  number      Int
  locked      Boolean  @default(false)
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, channelId])
  @@index([ownerId]) // GDPR cross-guild deletes
  @@map("tempvc_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: economy (guild-scoped bank + audited transaction ledger)
// ─────────────────────────────────────────────────────────────────────────────

model EconomyAccount {
  guildId      String    @map("guild_id") @db.VarChar(20)
  userId       String    @map("user_id") @db.VarChar(20)
  wallet       Int       @default(0)
  bank         Int       @default(0)
  lastPaydayAt DateTime? @map("last_payday_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  // guildId leads the PK so per-guild reads are covered; cross-guild GDPR
  // lookups by userId need their own index.
  @@index([userId])
  @@map("economy_accounts")
}

model EconomyTransaction {
  id           Int            @id @default(autoincrement())
  guildId      String         @map("guild_id") @db.VarChar(20)
  userId       String         @map("user_id") @db.VarChar(20)
  kind         EconomyTxnKind
  amount       Int
  balanceAfter Int            @map("balance_after")
  reason       String?        @db.VarChar(500)
  createdAt    DateTime       @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, createdAt])
  @@index([guildId, createdAt])
  // GDPR delete/export filter on userId across every guild.
  @@index([userId])
  @@map("economy_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: reactionroles
// ─────────────────────────────────────────────────────────────────────────────

model ReactionRoleMenu {
  id          String   @id @db.VarChar(32)
  guildId     String   @map("guild_id") @db.VarChar(20)
  title       String   @db.VarChar(100)
  description String?  @db.VarChar(1000)
  color       String?  @db.VarChar(7)
  mode        String   @db.VarChar(16) // "buttons" | "select" | "reactions"
  exclusive   Boolean  @default(false)
  maxRoles    Int      @default(1) @map("max_roles")
  channelId   String?  @map("channel_id") @db.VarChar(20)
  messageIds  String[] @map("message_ids")
  richContent Json     @map("rich_content")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  guild   Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  options ReactionRoleOption[]

  @@index([guildId])
  @@map("reactionrole_menus")
}

model ReactionRoleOption {
  id             Int     @id @default(autoincrement())
  menuId         String  @map("menu_id") @db.VarChar(32)
  // Caller-assigned slug, stable across a menu's full-option-array
  // replacement on every save - baked into already-posted Discord
  // button/select customIds, so it must never change once assigned.
  slug           String  @db.VarChar(32)
  position       Int     @default(0)
  label          String  @db.VarChar(80)
  emoji          String? @db.VarChar(100)
  description    String? @db.VarChar(100)
  roleId         String  @map("role_id") @db.VarChar(20)
  requiredRoleId String? @map("required_role_id") @db.VarChar(20)

  menu ReactionRoleMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, slug])
  @@index([menuId, position])
  @@map("reactionrole_options")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE: sticky
// ─────────────────────────────────────────────────────────────────────────────

// Unused for now: sticky entries are still edited entirely through the generic
// module-config-schema mechanism (dashboard support is auto-derived from that
// schema), and moving storage here would either break that or require a
// config-schema/table dual-write the zero-cross-module-import law makes awkward.
// Left in place for a future phase that builds the dashboard-side work to use it.
model StickyMessage {
  id           Int      @id @default(autoincrement())
  guildId      String   @map("guild_id") @db.VarChar(20)
  channelId    String   @map("channel_id") @db.VarChar(20)
  enabled      Boolean  @default(true)
  content      String   @db.VarChar(2000)
  accentColor  String?  @map("accent_color") @db.VarChar(7)
  imageUrls    String[] @map("image_urls")
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  richContent  Json?    @map("rich_content")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId], name: "uq_sticky_guild_channel")
  @@map("sticky_messages")
}
