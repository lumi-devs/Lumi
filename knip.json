{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/Index.ts",
    "src/cli/Main.ts",
    "src/lib/**/*.ts",
    "src/modules/*/Index.ts",
    "src/modules/*/commands/*.ts",
    "src/modules/*/listeners/*.ts",
    "src/modules/*/interactions/**/*.ts",
    "src/modules/*/tasks/*.ts",
    "src/modules/*/utilities/*.ts",
    "src/scripts/*.ts",
    "prisma.config.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "prisma.config.ts"]
}
