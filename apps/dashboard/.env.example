# Discord OAuth2 application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match the redirect added in the Discord developer portal.
# Defaults to ${WEB_BASE_URL}/auth/callback when unset.
DISCORD_OAUTH_REDIRECT_URI=http://localhost:4173/auth/callback

# Public base URL used for verification links and OAuth defaults.
WEB_BASE_URL=http://localhost:4173

# Random 32+ byte secret used to sign session cookies and derive Redis keys.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=604800

# Database and Redis (same instances as the bot).
DATABASE_URL=postgresql://lumi:lumi@127.0.0.1:5432/lumi
REDIS_URL=redis://localhost:6379/0
# Used only when REDIS_URL is unset.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Bot token is used for server/role summary and web verification role changes.
BOT_TOKEN=replace-me

# Optional path overrides. Defaults are resolved from the current directory.
LUMI_MODULES_DIR=
LUMI_DATA_DIR=
# Set to 1 only for local production testing over plain HTTP.
DASHBOARD_INSECURE_COOKIES=0
