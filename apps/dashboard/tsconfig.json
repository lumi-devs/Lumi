{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    // This is an app, not a published library — no .d.ts output is ever
    // needed. Also sidesteps TS2742 ("inferred type cannot be named without
    // a reference to .../node_modules/...") that `declaration: true`
    // (inherited from tsconfig.base.json) triggers on NextAuth v5's `auth`/
    // `signIn` exports under bun's isolated node_modules layout.
    "declaration": false,
    "declarationMap": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "react", "react-dom"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "allowJs": false,
    "allowImportingTsExtensions": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
