{
  "name": "@lumi/dashboard",
  "version": "3.3.0",
  "license": "GPL-3.0-only",
  "description": "Web admin dashboard (Next.js App Router) - Discord OAuth login via NextAuth.js + auto-generated config forms, served over the RabbitMQ RPC bridge.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H \"${DASHBOARD_HOST:-0.0.0.0}\" -p \"${DASHBOARD_PORT:-8080}\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumi/contracts": "workspace:*",
    "@lumi/observability": "workspace:*",
    "@tanstack/react-table": "^8",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "^1.6.7",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-types": "latest",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}
