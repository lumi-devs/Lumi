{
  "name": "@lumi/dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "svelte-kit sync",
    "dev": "vite dev --host 0.0.0.0 --port 4173",
    "build": "vite build",
