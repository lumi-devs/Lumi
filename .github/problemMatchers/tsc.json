{
	"problemMatcher": [
		{
			"owner": "tsc",
			"pattern": [
				{
					"regexp": "^(?:\\s+\\d+\\>)?([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\)\\s*:\\s+(error|warning|info)\\s+(\\w{1,2}\\d+)\\s*:\\s*(.*)$",
					"file": 1,
					"location": 2,
					"severity": 3,
					"message": 4,
					"code": 5
				}
			]
		}
	]
}
