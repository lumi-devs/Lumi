node_modules/
dist/
.antigravitycli/
prisma/
# prisma/ above is unanchored; keep our hand-written data layer (the generated
# client is ignored separately via /src/generated/prisma below).
!/src/prisma/
.env
*.log
logs/
drizzle/*.sql
# keep drizzle/ folder but not committed migration SQL (generate them fresh)
!drizzle/.gitkeep

/src/generated/prisma
.aider*

# Runtime-downloaded 3rd-party module repos (cloned by /repo at runtime). Contains
# embedded git repos — never commit, never add as a submodule.
/data/
