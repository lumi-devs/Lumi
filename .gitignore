node_modules/
dist/
tmp/
.antigravitycli/
# Prisma: ignore only the generated client and any local dev DB. The schema,
# migrations, and the data layer (packages/*/src/prisma) are tracked source.
/prisma/generated/
/prisma/*.db
# Local tooling / reference clones, never part of the repo.
/.ai-knowledge/
.claude/
.env
*.log
logs/
drizzle/*.sql
# keep drizzle/ folder but not committed migration SQL (generate them fresh)
!drizzle/.gitkeep

/src/generated/prisma
.aider*

# Runtime-downloaded 3rd-party module repos (cloned by /repo at runtime). Contains
# embedded git repos — never commit, never add as a submodule.
/data/
