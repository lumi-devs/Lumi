node_modules/
dist/
.antigravitycli/
# Prisma: ignore build artifacts ONLY. The schema, migrations, and the hand-written
# data layer (packages/*/src/prisma — DatabaseService + repositories) are SOURCE and
# MUST be tracked. The old unanchored `prisma/` rule silently un-tracked BOTH
# packages/core/src/prisma AND prisma/migrations (migrate deploy needs the committed
# baseline to bootstrap a fresh DB) — see HARDENING P1.4/P1.5. Anchored rules fix it.
/prisma/generated/
/prisma/*.db
# AI reference clones under .ai-knowledge are embedded git repos, not our source.
/.ai-knowledge/prisma/
.env
*.log
logs/
drizzle/*.sql
# keep drizzle/ folder but not committed migration SQL (generate them fresh)
!drizzle/.gitkeep

/src/generated/prisma
.aider*

# Runtime-downloaded 3rd-party module repos (cloned by /repo at runtime). Contains
# embedded git repos — never commit, never add as a submodule.
/data/
