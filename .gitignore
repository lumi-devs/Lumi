node_modules/
dist/
tmp/
coverage/
.turbo/
*.tsbuildinfo
.antigravitycli/
# Next.js build output (apps/dashboard).
.next/
next-env.d.ts
# Astro build output/type cache (apps/docs).
.astro/
# Prisma: ignore only the generated client and any local dev DB. The schema,
# migrations, and the data layer (packages/*/src/prisma) are tracked source.
/prisma/generated/
/prisma/*.db
# Local tooling / reference clones, never part of the repo.
/.ai-knowledge/
.claude/
.env
*.log
logs/
# Native Redis dev snapshot, written to cwd by `redis-server` when run outside Docker.
dump.rdb
indirections.txt
/src/generated/prisma
.aider*

# Runtime-downloaded 3rd-party module repos (cloned by /repo at runtime). Contains
# embedded git repos — never commit, never add as a submodule.
/data/
.agents/

# Archives and binaries
*.zip
*.tar.gz
*.exe

# Local scratch dir for `bun run addon:create` output (point LUMI_DEV_PATHS at
# it, or move the addon into a real lumi-addons checkout when it's ready).
/addons/
.bug-hunter/
