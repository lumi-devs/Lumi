FROM docker.io/oven/bun:1-alpine AS base
WORKDIR /app
RUN apk add --no-cache dumb-init nodejs

FROM base AS builder
ENV NODE_ENV=production
ENV SKIP_ENV_VALIDATION=1
ENV RPC_HTTP_URL=http://127.0.0.1:8091
ENV DISCORD_OAUTH2_CLIENT_ID=build-placeholder
ENV DISCORD_OAUTH2_CLIENT_SECRET=build-placeholder
ENV DASHBOARD_SESSION_SECRET=build-placeholder-session-secret-must-be-32chars

COPY package.json bun.lock tsconfig.base.json tsconfig.json turbo.json prisma.config.ts ./
COPY packages/ packages/
COPY apps/dashboard/ apps/dashboard/
COPY apps/worker/package.json apps/worker/package.json
COPY apps/docs/package.json apps/docs/package.json
COPY prisma/ prisma/
COPY .github/ .github/

RUN bun install --frozen-lockfile
RUN bunx prisma generate
RUN bun run --filter=@lumi/dashboard build

FROM base AS runner
ENV NODE_ENV=production
ENV DASHBOARD_PORT=8080
ENV DASHBOARD_HOST=0.0.0.0

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/dashboard ./apps/dashboard
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/bun.lock ./bun.lock
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/.github ./.github

RUN chown -R bun:bun /app
USER bun

EXPOSE 8080

ENTRYPOINT ["dumb-init", "--"]
CMD ["bun", "run", "--cwd", "apps/dashboard", "start"]
