{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@lumi/core": [
        "src/core"
      ],
      "@lumi/admin": [
        "src/admin"
      ],
      "@lumi/permits": [
        "packages/permits/src"
      ],
      "@lumi/cache": [
        "packages/cache/src"
      ],
      "@lumi/redis": [
        "packages/redis/src"
      ],
      "@lumi/db": [
        "packages/db/src"
      ],
      "@lumi/ui": [
        "packages/ui/src"
      ],
      "@lumi/observability": [
        "packages/observability/src"
      ],
      "@lumi/scheduler": [
        "packages/scheduler/src"
      ],
      "@lumi/module-kit": [
        "packages/module-kit/src"
      ],
      "@lumi/module-runtime": [
        "packages/module-runtime/src"
      ],
      "@lumi/downloader": [
        "packages/downloader/src"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
