{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@lumi/core": [
        "apps/bot/src/core/src"
      ],
      "@lumi/admin": [
        "apps/bot/src/admin/src"
      ],
      "@lumi/permits": [
        "packages/permits/src"
      ],
      "@lumi/cache": [
        "packages/cache/src"
      ],
      "@lumi/redis": [
        "packages/redis/src"
      ],
      "@lumi/db": [
        "packages/db/src"
      ],
      "@lumi/ui": [
        "packages/ui/src"
      ],
      "@lumi/observability": [
        "packages/observability/src"
      ],
      "@lumi/scheduler": [
        "packages/scheduler/src"
      ],
      "@lumi/module-kit": [
        "packages/module-kit/src"
      ],
      "@lumi/module-runtime": [
        "packages/module-runtime/src"
      ],
      "@lumi/downloader": [
        "packages/downloader/src"
      ],
      "@lumi/utility": [
        "modules/utility/submodules/utility"
      ],
      "@lumi/tempvc": [
        "modules/utility/submodules/tempvc"
      ],
      "@lumi/logging": [
        "modules/logging/submodules/logging"
      ],
      "@lumi/afk": [
        "modules/utility/submodules/afk"
      ],
      "@lumi/community-leveling": [
        "modules/community/submodules/leveling"
      ],
      "@lumi/community-economy": [
        "modules/community/submodules/economy"
      ],
      "@lumi/moderation-mod": [
        "modules/moderation/submodules/mod"
      ],
      "@lumi/security": [
        "modules/security"
      ],
      "@lumi/security-antinuke": [
        "modules/security/submodules/antinuke"
      ],
      "@lumi/security-join-gate": [
        "modules/security/submodules/join-gate"
      ],
      "@lumi/security-verification": [
        "modules/security/submodules/verification"
      ],
      "@lumi/security-panic": [
        "modules/security/submodules/panic"
      ],
      "@lumi/security-backups": [
        "modules/security/submodules/backups"
      ],
      "@lumi/security-betrayal": [
        "modules/security/submodules/betrayal"
      ],
      "@lumi/security-autorecovery": [
        "modules/security/submodules/autorecovery"
      ],
      "@lumi/security-automod": [
        "modules/security/submodules/automod"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
