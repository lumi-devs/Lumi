{
  "name": "@lumi/contracts",
  "version": "0.9.0",
  "license": "AGPL-3.0-only",
  "description": "Shared wire contracts (bus events, RPC payloads, module manifest, config fields) for all Lumi services.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumi-devs/Lumi.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./views": {
      "bun": "./src/views.ts",
      "types": "./dist/views.d.ts",
      "default": "./dist/views.js"
    },
    "./rpc": {
      "bun": "./src/rpc/index.ts",
      "types": "./dist/rpc/index.d.ts",
      "default": "./dist/rpc/index.js"
    },
    "./rpc/client": {
      "bun": "./src/rpc/client.ts",
      "types": "./dist/rpc/client.d.ts",
      "default": "./dist/rpc/client.js"
    },
    "./events": {
      "bun": "./src/events.ts",
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "discord.js": "^14.20.0"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  }
}
