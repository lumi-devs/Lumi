{
  "name": "@lumi/contracts",
  "version": "0.5.0-next.0",
  "license": "GPL-3.0-only",
  "description": "Shared wire contracts (bus events, RPC payloads, module manifest, config fields) for all Lumi services.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumi-devs/Lumi.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./views": {
      "bun": "./src/views.ts",
      "types": "./dist/views.d.ts",
      "default": "./dist/views.js"
    },
    "./rpc": {
      "bun": "./src/rpc/index.ts",
      "types": "./dist/rpc/index.d.ts",
      "default": "./dist/rpc/index.js"
    },
    "./events": {
      "bun": "./src/events.ts",
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "discord.js": "^14.20.0"
  },
  "dependencies": {
    "@sapphire/shapeshift": "^5.0.0"
  }
}
