generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Polarity {
  GRANT
  DENY
}

enum PermitTargetType {
  USER
  ROLE
  CHANNEL
}

model Guild {
  id            String   @id
  name          String   @default("")
  icon          String?
  ownerId       String   @default("") @map("owner_id")
  joinedAt      DateTime @default(now()) @map("joined_at")
  leftAt        DateTime? @map("left_at")
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  permits       Permit[]
  permitAssignments PermitAssignment[]
  modules       GuildModule[]
  levelingConfig LevelingConfig?
  economyConfig EconomyConfig?
  tempVcConfig  TempVcConfig?
  securityConfig SecurityConfig?
  sheets        Sheet[]

  @@map("guilds")
}

model Permit {
  id          Int           @id @default(autoincrement())
  guildId     String        @map("guild_id")
  guild       Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  node        String
  polarity    Polarity
  position    Int
  builtin     Boolean       @default(false)
  expiresAt   DateTime?     @map("expires_at")
  schedule    Json?
  timezone    String?
  conditions  Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  assignments PermitAssignment[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("permits")
}

model PermitAssignment {
  id          Int              @id @default(autoincrement())
  permitId    Int              @map("permit_id")
  permit      Permit           @relation(fields: [permitId], references: [id], onDelete: Cascade)
  guildId     String           @map("guild_id")
  guild       Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  targetType  PermitTargetType @map("target_type")
  targetId    String           @map("target_id")
  grantedAt   DateTime         @default(now()) @map("granted_at")
  grantedBy   String           @map("granted_by")
  expiresAt   DateTime?        @map("expires_at")

  @@unique([permitId, targetType, targetId])
  @@index([permitId])
  @@index([targetType, targetId])
  @@index([guildId])
  @@map("permit_assignments")
}

model GuildModule {
  id        String   @id @default(cuid())
  guildId   String   @map("guild_id")
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  module    String
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guildId, module])
  @@index([guildId])
  @@map("guild_modules")
}

// Leveling
model LevelingConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique @map("guild_id")
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  xpPerMessage    Int      @default(15) @map("xp_per_message")
  xpPerMinuteVc   Int      @default(10) @map("xp_per_minute_vc")
  cooldownSeconds Int      @default(60) @map("cooldown_seconds")
  xpCurve         Json     @default("{}") @map("xp_curve")
  roleRewards     Json     @default("[]") @map("role_rewards")
  multiplierRoles Json     @default("[]") @map("multiplier_roles")
  ignoredChannels Json     @default("[]") @map("ignored_channels")
  ignoredRoles    Json     @default("[]") @map("ignored_roles")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("leveling_configs")
}

model LevelingUser {
  id        String   @id @default(cuid())
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  xp        BigInt   @default(0)
  level     Int      @default(0)
  totalXp   BigInt   @default(0) @map("total_xp")
  lastXpAt  DateTime? @map("last_xp_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guildId, userId])
  @@index([guildId, level])
  @@index([guildId, xp])
  @@map("leveling_users")
}

// Economy
model EconomyConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique @map("guild_id")
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  currencyName    String   @default("Credits") @map("currency_name")
  currencySymbol  String   @default("💰") @map("currency_symbol")
  startingBalance Int      @default(0) @map("starting_balance")
  dailyAmount     Int      @default(100) @map("daily_amount")
  weeklyAmount    Int      @default(500) @map("weekly_amount")
  monthlyAmount   Int      @default(2000) @map("monthly_amount")
  interestRate    Float    @default(0.01) @map("interest_rate")
  taxRate         Float    @default(0.0) @map("tax_rate")
  workCooldown    Int      @default(3600) @map("work_cooldown")
  workMinPay      Int      @default(50) @map("work_min_pay")
  workMaxPay      Int      @default(200) @map("work_max_pay")
  shopItems       Json     @default("[]") @map("shop_items")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("economy_configs")
}

model EconomyUser {
  id            String   @id @default(cuid())
  guildId       String   @map("guild_id")
  userId        String   @map("user_id")
  balance       BigInt   @default(0)
  bankBalance   BigInt   @default(0) @map("bank_balance")
  totalEarned   BigInt   @default(0) @map("total_earned")
  totalSpent    BigInt   @default(0) @map("total_spent")
  lastDailyAt   DateTime? @map("last_daily_at")
  lastWeeklyAt  DateTime? @map("last_weekly_at")
  lastMonthlyAt DateTime? @map("last_monthly_at")
  lastWorkAt    DateTime? @map("last_work_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([guildId, userId])
  @@index([guildId, balance])
  @@map("economy_users")
}

model EconomyTransaction {
  id          String   @id @default(cuid())
  guildId     String   @map("guild_id")
  fromUserId  String?  @map("from_user_id")
  toUserId    String?  @map("to_user_id")
  amount      BigInt
  type        String   // transfer, deposit, withdraw, purchase, work, daily, etc.
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([guildId])
  @@index([guildId, fromUserId])
  @@index([guildId, toUserId])
  @@index([createdAt])
  @@map("economy_transactions")
}

model EconomyInventory {
  id        String   @id @default(cuid())
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  quantity  Int      @default(1)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guildId, userId, itemId])
  @@index([guildId, userId])
  @@map("economy_inventory")
}

// TempVC
model TempVcConfig {
  id                String   @id @default(cuid())
  guildId           String   @unique @map("guild_id")
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  categoryId        String?  @map("category_id")
  templateName      String   @default("➕ {user}'s Channel") @map("template_name")
  defaultBitrate    Int      @default(64000) @map("default_bitrate")
  defaultUserLimit  Int      @default(0) @map("default_user_limit")
  maxChannels       Int      @default(50) @map("max_channels")
  maxPerUser        Int      @default(1) @map("max_per_user")
  emptyTimeoutMs    Int      @default(300000) @map("empty_timeout_ms")
  ownerLeaveDelete  Boolean  @default(true) @map("owner_leave_delete")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("tempvc_configs")
}

model TempVcChannel {
  id          String   @id @default(cuid())
  guildId     String   @map("guild_id")
  channelId   String   @unique @map("channel_id")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([guildId])
  @@index([guildId, ownerId])
  @@map("tempvc_channels")
}

// Security
model SecurityConfig {
  id                String   @id @default(cuid())
  guildId           String   @unique @map("guild_id")
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  verificationMode  String   @default("none") @map("verification_mode") // none, emoji, button, captcha, question
  verificationRole  String?  @map("verification_role")
  verificationChannel String? @map("verification_channel")
  captchaProvider   String?  @map("captcha_provider")
  captchaSecret     String?  @map("captcha_secret")
  antinukeEnabled   Boolean  @default(true) @map("antinuke_enabled")
  antinukeThresholds Json     @default("{}") @map("antinuke_thresholds")
  antinukePunishment String   @default("ban") @map("antinuke_punishment")
  joinGateEnabled   Boolean  @default(false) @map("join_gate_enabled")
  joinGateHeuristics Json     @default("{}") @map("join_gate_heuristics")
  panicEnabled      Boolean  @default(false) @map("panic_enabled")
  panicPreviousPerms Json?   @map("panic_previous_perms")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("security_configs")
}

model VerificationPending {
  id           String   @id @default(cuid())
  guildId      String   @map("guild_id")
  userId       String   @map("user_id")
  method       String   // emoji, button, captcha, question
  attempts     Int      @default(0)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([guildId, userId])
  @@map("verification_pending")
}

// Sheets
model Sheet {
  id          String   @id @default(cuid())
  guildId     String   @map("guild_id")
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rows        Json     @default("[]")
  triggers    Json     @default("[]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([guildId])
  @@map("sheets")
}

// Module addons
model InstalledAddon {
  id          String   @id @default(cuid())
  name        String
  version     String
  source      String   // github, npm, local
  sourceUrl   String?  @map("source_url")
  installedAt DateTime @default(now()) @map("installed_at")
  enabled     Boolean  @default(true)
  manifest    Json

  @@unique([name, version])
  @@map("installed_addons")
}

// Audit log
model AuditLog {
  id        String   @id @default(cuid())
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  action    String
  targetId  String?  @map("target_id")
  targetType String? @map("target_type")
  changes   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([guildId])
  @@index([guildId, userId])
  @@index([createdAt])
  @@map("audit_logs")
}