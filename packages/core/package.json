{
  "name": "@lumi/core",
  "version": "2.1.1",
  "license": "Apache-2.0",
  "description": "Lumi core — the full bot library (framework glue, module system, DB/Redis/RabbitMQ layers, core commands).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./setup": "./src/client/setup.ts",
    "./client": "./src/client/LumiClient.ts"
  },
  "imports": {
    "#lib/commands.js": "./src/core/lib/commands.ts",
    "#lib/env.js": "./src/core/env.ts",
    "#lib/permissions.js": "./src/core/permissions/index.ts",
    "#lib/module-system.js": "./src/core/module-system/Module.ts",
    "#lib/rabbit.js": "./src/core/rabbitmq/index.ts",
    "#lib/types.js": "./src/core/types/common.ts",
    "#lib/guild-transaction.js": "./src/core/lib/guild-transaction.ts",
    "#database/*.js": "./src/database/*.ts",
    "#utilities/*.js": "./src/utilities/*.ts",
    "#core/*.js": "./src/core/*.ts",
    "#root/*.js": "./src/*.ts",
    "#modules/*.js": "./src/modules/*.ts",
    "#lib/module-check.js": "./src/core/lib/module-check.ts",
    "#lib/scheduler-bus.js": "./src/core/lib/scheduler-bus.ts",
    "#lib/schedule-task.js": "./src/core/lib/schedule-task.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext ts --fix"
  },
  "dependencies": {
    "@discordjs/builders": "^1.10.0",
    "@discordjs/formatters": "^0.6.0",
    "@lumi/contracts": "workspace:*",
    "@lumi/event-bus": "workspace:*",
    "@lumi/observability": "workspace:*",
    "@lumi/sharding": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/plugin-scheduled-tasks": "^10.0.4",
    "@sapphire/plugin-subcommands": "^7.0.1",
    "@sapphire/snowflake": "^3.5.5",
    "@sapphire/stopwatch": "^1.5.4",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/utilities": "^3.18.2",
    "@sentry/node": "^10.53.1",
    "ahocorasick": "^1.0.2",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "chrono-node": "^2.9.1",
    "colorette": "^2.0.20",
    "discord.js": "^14.20.0",
    "ioredis": "^5.10.1",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  }
}
