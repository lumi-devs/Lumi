{
  "name": "@lumi/core",
  "version": "3.2.0",
  "license": "GPL-3.0-only",
  "description": "Lumi core - the full bot library (framework glue, module system, DB/Redis layers, core commands).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./setup": "./src/lib/client/setup.ts",
    "./client": "./src/lib/client/LumiClient.ts"
  },
  "imports": {
    "#lib/commands.js": "./src/lib/commands.ts",
    "#lib/env.js": "./src/lib/env.ts",
    "#lib/permissions.js": "./src/lib/permissions/index.ts",
    "#lib/module-system.js": "./src/lib/module-system/Module.ts",
    "#lib/types.js": "./src/lib/types/common.ts",
    "#lib/guild-transaction.js": "./src/lib/guild-transaction.ts",
    "#lib/module-check.js": "./src/lib/module-check.ts",
    "#lib/scheduler-bus.js": "./src/lib/scheduler-bus.ts",
    "#lib/schedule-task.js": "./src/lib/schedule-task.ts",
    "#lib/*.js": "./src/lib/*.ts",
    "#database/*.js": "./src/lib/database/*.ts",
    "#utilities/*.js": "./src/lib/utilities/*.ts",
    "#core/lib/*.js": "./src/lib/*.ts",
    "#core/module-system/*.js": "./src/lib/module-system/*.ts",
    "#core/*.js": "./src/lib/*.ts",
    "#root/*.js": "./src/*.ts",
    "#modules/*.js": "./src/modules/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext ts --fix"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@lumi/contracts": "workspace:*",
    "@lumi/event-bus": "workspace:*",
    "@lumi/observability": "workspace:*",
    "@lumi/sharding": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/fetch": "^3.0.5",
    "@sapphire/framework": "^5.5.1",
    "@sapphire/plugin-hmr": "^3.0.2",
    "@sapphire/plugin-i18next": "^8.0.0",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/plugin-scheduled-tasks": "^10.0.4",
    "@sapphire/plugin-subcommands": "^7.0.1",
    "@sapphire/plugin-utilities-store": "^2.0.3",
    "@sapphire/ratelimits": "^2.4.11",
    "@sapphire/shapeshift": "^5.0.0",
    "@sapphire/snowflake": "^3.5.5",
    "@sapphire/stopwatch": "^1.5.4",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/utilities": "^3.18.2",
    "ahocorasick": "^1.0.2",
    "cluster-key-slot": "^1.1.2",
    "colorette": "^2.0.20",
    "discord.js": "^14.27.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  }
}
