{
  "apiVersion": 2,
  "name": "logging",
  "displayName": "Logging",
  "emoji": "📝",
  "description": "Message, edit, delete, voice, and moderation logging",
  "version": "2.0.0",
  "isSupermodule": true,
  "entry": "index.ts",
  "submodules": {
    "logs": {
      "name": "logging-logs",
      "displayName": "Logging",
      "emoji": "📝",
      "description": "Message, edit, delete, voice, and moderation logging",
      "version": "2.0.0",
      "entry": "submodules/logging/src/index.ts",
      "requirements": [
        "logging"
      ]
    }
  },
  "configFields": [
    {
      "key": "messageLogChannel",
      "label": "Message Log Channel",
      "type": "channel",
      "description": "Log message edits/deletes",
      "default": null
    },
    {
      "key": "editLogChannel",
      "label": "Edit Log Channel",
      "type": "channel",
      "description": "Log message edits",
      "default": null
    },
    {
      "key": "deleteLogChannel",
      "label": "Delete Log Channel",
      "type": "channel",
      "description": "Log message deletes",
      "default": null
    },
    {
      "key": "voiceLogChannel",
      "label": "Voice Log Channel",
      "type": "channel",
      "description": "Log voice state changes",
      "default": null
    },
    {
      "key": "modLogChannel",
      "label": "Mod Log Channel",
      "type": "channel",
      "description": "Log moderation actions",
      "default": null
    },
    {
      "key": "ignoredChannels",
      "label": "Ignored Channels",
      "type": "multi-channel",
      "description": "Channels to exclude from logging",
      "default": []
    }
  ]
}
