{
  "apiVersion": 2,
  "name": "community-leveling",
  "displayName": "Leveling",
  "emoji": "📈",
  "description": "XP, levels, role rewards, and leaderboards with voice XP support",
  "version": "2.1.0",
  "entry": "index.ts",
  "configKey": "leveling",
  "configFields": [
    {
      "key": "levelFormula",
      "label": "Level Formula",
      "type": "select",
      "description": "Curve for XP required per level",
      "default": "disgaea",
      "choices": [
        "disgaea",
        "fibonacci",
        "linear",
        "mee6",
        "atlas",
        "arcane",
        "lurkr"
      ],
      "category": "XP & Cooldown"
    },
    {
      "key": "xpPerMessage",
      "label": "XP per Message",
      "type": "number",
      "description": "Base XP per message",
      "default": 15,
      "category": "XP & Cooldown"
    },
    {
      "key": "cooldownSeconds",
      "label": "XP Cooldown",
      "type": "number",
      "description": "Seconds between XP gains",
      "default": 60,
      "category": "XP & Cooldown"
    },
    {
      "key": "voiceEnabled",
      "label": "Voice XP Enabled",
      "type": "boolean",
      "description": "Track voice minutes and grant XP for time in voice channels",
      "default": false,
      "category": "Voice XP"
    },
    {
      "key": "voiceXpPerMinute",
      "label": "Voice XP Per Minute",
      "type": "number",
      "description": "XP granted per audible minute in voice",
      "default": 4,
      "category": "Voice XP"
    },
    {
      "key": "announceEnabled",
      "label": "Level-Up Announcements",
      "type": "boolean",
      "description": "Post a message when a member levels up",
      "default": true,
      "category": "Announcements"
    },
    {
      "key": "announceChannel",
      "label": "Announcement Channel",
      "type": "channel",
      "description": "Channel for level-up messages",
      "category": "Announcements"
    },
    {
      "key": "announceMessage",
      "label": "Announcement Message",
      "type": "string",
      "description": "Level-up message template. Supports {user}, {level}, {xp}, {xpNeeded}",
      "default": "{user} reached level {level}!",
      "category": "Announcements"
    },
    {
      "key": "minMessageLength",
      "label": "Minimum Message Length",
      "type": "number",
      "description": "Messages shorter than this earn no XP",
      "default": 4,
      "category": "XP & Cooldown"
    },
    {
      "key": "roleRewards",
      "label": "Role Rewards",
      "type": "json",
      "description": "JSON array: [{level, roleId, removePrevious}]",
      "default": [],
      "category": "Rewards"
    },
    {
      "key": "roleStack",
      "label": "Stack Reward Roles",
      "type": "boolean",
      "description": "Keep every earned reward role",
      "default": true,
      "category": "Rewards"
    },
    {
      "key": "keepXpOnLeave",
      "label": "Keep XP On Leave",
      "type": "boolean",
      "description": "Keep progress and restore reward roles on rejoin",
      "default": true,
      "category": "Rewards"
    },
    {
      "key": "globalMultiplier",
      "label": "Global XP Multiplier",
      "type": "number",
      "description": "Multiplies all XP gains on this server",
      "default": 1,
      "min": 0,
      "max": 100,
      "category": "Multipliers"
    },
    {
      "key": "multiplierRoles",
      "label": "XP Multiplier Roles",
      "type": "json",
      "description": "JSON array: [{roleId, multiplier}]",
      "default": [],
      "category": "Multipliers"
    },
    {
      "key": "channelMultipliers",
      "label": "Channel XP Multipliers",
      "type": "json",
      "description": "JSON array: [{channelId, multiplier}]",
      "default": [],
      "category": "Multipliers"
    },
    {
      "key": "ignoredChannels",
      "label": "Ignored Channels",
      "type": "multi-channel",
      "description": "Text channels where message XP is disabled. Inactive while a channel whitelist is set.",
      "default": [],
      "category": "Filters"
    },
    {
      "key": "whitelistedChannels",
      "label": "Whitelisted Channels",
      "type": "multi-channel",
      "description": "Only these text channels earn message XP. Overrides the ignored channel list.",
      "default": [],
      "category": "Filters"
    },
    {
      "key": "ignoredRoles",
      "label": "Ignored Roles",
      "type": "multi-role",
      "description": "Members with any of these roles earn no XP. Inactive while a role whitelist is set.",
      "default": [],
      "category": "Filters"
    },
    {
      "key": "whitelistedRoles",
      "label": "Whitelisted Roles",
      "type": "multi-role",
      "description": "Only members with one of these roles earn XP. Overrides the ignored role list.",
      "default": [],
      "category": "Filters"
    }
  ],
  "dependencies": {
    "community": "^2.0.0"
  }
}
