{
  "apiVersion": 2,
  "name": "community-leveling",
  "displayName": "Leveling",
  "emoji": "📈",
  "description": "XP, levels, role rewards, and leaderboards with voice XP support",
  "version": "2.1.0",
  "entry": "index.ts",
  "configFields": [
    {
      "key": "levelFormula",
      "label": "Level Formula",
      "type": "select",
      "description": "Curve for XP required per level",
      "default": "disgaea",
      "choices": [
        "disgaea",
        "fibonacci",
        "linear",
        "mee6",
        "atlas",
        "arcane",
        "lurkr"
      ]
    },
    {
      "key": "xpPerMessage",
      "label": "XP per Message",
      "type": "number",
      "description": "Base XP per message",
      "default": 15
    },
    {
      "key": "cooldownSeconds",
      "label": "XP Cooldown",
      "type": "number",
      "description": "Seconds between XP gains",
      "default": 60
    },
    {
      "key": "voiceEnabled",
      "label": "Voice XP Enabled",
      "type": "boolean",
      "description": "Track voice minutes and grant XP for time in voice channels",
      "default": false
    },
    {
      "key": "voiceXpPerMinute",
      "label": "Voice XP Per Minute",
      "type": "number",
      "description": "XP granted per audible minute in voice",
      "default": 4
    },
    {
      "key": "announceEnabled",
      "label": "Level-Up Announcements",
      "type": "boolean",
      "description": "Post a message when a member levels up",
      "default": true
    },
    {
      "key": "announceChannel",
      "label": "Announcement Channel",
      "type": "channel",
      "description": "Channel for level-up messages"
    },
    {
      "key": "announceMessage",
      "label": "Announcement Message",
      "type": "string",
      "description": "Level-up message template. Supports {user}, {level}, {xp}, {xpNeeded}",
      "default": "{user} reached level {level}!"
    },
    {
      "key": "minMessageLength",
      "label": "Minimum Message Length",
      "type": "number",
      "description": "Messages shorter than this earn no XP",
      "default": 4
    },
    {
      "key": "roleRewards",
      "label": "Role Rewards",
      "type": "json",
      "description": "JSON array: [{level, roleId, removePrevious}]",
      "default": []
    },
    {
      "key": "roleStack",
      "label": "Stack Reward Roles",
      "type": "boolean",
      "description": "Keep every earned reward role",
      "default": true
    },
    {
      "key": "keepXpOnLeave",
      "label": "Keep XP On Leave",
      "type": "boolean",
      "description": "Keep progress and restore reward roles on rejoin",
      "default": true
    },
    {
      "key": "globalMultiplier",
      "label": "Global XP Multiplier",
      "type": "number",
      "description": "Multiplies all XP gains on this server",
      "default": 1,
      "min": 0,
      "max": 100
    },
    {
      "key": "multiplierRoles",
      "label": "XP Multiplier Roles",
      "type": "json",
      "description": "JSON array: [{roleId, multiplier}]",
      "default": []
    },
    {
      "key": "channelMultipliers",
      "label": "Channel XP Multipliers",
      "type": "json",
      "description": "JSON array: [{channelId, multiplier}]",
      "default": []
    },
    {
      "key": "ignoredChannels",
      "label": "Ignored Channels",
      "type": "multi-channel",
      "description": "Channels where XP is disabled",
      "default": []
    },
    {
      "key": "ignoredRoles",
      "label": "Ignored Roles",
      "type": "multi-role",
      "description": "Roles that don't gain XP",
      "default": []
    }
  ],
  "dependencies": {
    "community": "^2.0.0"
  }
}
