{
  "apiVersion": 2,
  "name": "mod",
  "displayName": "Moderation",
  "emoji": "🛡️",
  "description": "Case-backed moderation with bans, kicks, timeouts, warns, purge, notes, lockdown, softban, quarantine, voice mute",
  "version": "2.0.0",
  "entry": "src/index.ts",
  "dependencies": {},
  "requirements": [],
  "conflicts": [],
  "capabilities": [],
  "defaultEnabled": true,
  "configFields": [
    {
      "key": "quarantineRoleId",
      "label": "Quarantine Role",
      "type": "role",
      "description": "Role assigned when quarantined",
      "default": null
    },
    {
      "key": "maxTargets",
      "label": "Max Targets",
      "type": "number",
      "description": "Max members per command",
      "default": 10
    },
    {
      "key": "immuneRoleIds",
      "label": "Immune Roles",
      "type": "multi-role",
      "description": "Roles exempt from auto-actions",
      "default": []
    },
    {
      "key": "warnThresholds",
      "label": "Warn Thresholds",
      "type": "json",
      "description": "JSON object: warn count -> {action, duration}",
      "default": {}
    }
  ]
}
