{
  "$schema": "https://turbo.build/schema.json",
  // "loose": every task inherits the full shell environment. This repo has
  // no remote-cache/CI scenario across untrusted contributors that would
  // need turbo's default "strict" per-task env allowlisting.
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#lint:all": {},
    "//#lint:all:fix": {
      "cache": false
    },
    "test": {}
  }
}
