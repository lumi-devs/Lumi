{
  "$schema": "https://turbo.build/schema.json",
  // "loose": every task inherits the full shell environment. This repo has
  // no remote-cache/CI scenario across untrusted contributors that would
  // need turbo's default "strict" per-task env allowlisting.
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // apps/docs is a Next.js app, so its output is ".next/**" (excluding
      // Next's own incremental cache dir, which shouldn't be treated as a
      // build artifact to restore).
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#lint:all": {},
    "test": {}
  }
}
