# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_client_id

# ── Owner IDs (comma-separated) ───────────────────────────────────────────────
OWNER_IDS=

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://ember:ember@localhost:5432/ember
POSTGRES_PASSWORD=ember

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ember
REDIS_CACHE_DB=0
REDIS_TASK_DB=1

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Leave blank to disable RabbitMQ (Redis-only mode). Docker Compose sets this
# automatically via the environment: block, so you only need it for bare-metal.
RABBITMQ_URL=amqp://ember:ember@localhost:5672
RABBITMQ_USER=ember
RABBITMQ_PASSWORD=ember

# ── Bot behaviour ─────────────────────────────────────────────────────────────
DEFAULT_PREFIX=,
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_ENABLED=false
SENTRY_DSN=https://e95e5666c2cd1df4e47b4d9d406c803a@o4511430036357120.ingest.de.sentry.io/4511430050775120

# ── Scalability ───────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ── Cache TTL (seconds) ───────────────────────────────────────────────────────
EMBER_CACHE_TTL=60
