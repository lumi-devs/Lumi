# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_client_id

# ── Owner IDs (comma-separated) ───────────────────────────────────────────────
OWNER_IDS=

# ── Postgres ───────────────────────────────────────────────────────────────────
# Runtime connection. Under docker-compose this points at PgBouncer (pgbouncer:6432);
# for a bare local Postgres point it straight at the server.
POSTGRES_URL=postgresql://lumi:lumi@localhost:5432/lumi
POSTGRES_PASSWORD=lumi
# Direct (non-pooled) URL used by Prisma migrations only — DDL and advisory locks
# can't run through a transaction-pooled PgBouncer. Leave unset when not using PgBouncer.
DIRECT_POSTGRES_URL=postgresql://lumi:lumi@localhost:5432/lumi
# Per-process client-connection cap (pg Pool max). Keep small behind PgBouncer.
POSTGRES_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=lumi
REDIS_CACHE_DB=0
REDIS_TASK_DB=1
# Sentinel-aware connection. When REDIS_SENTINELS is set, every Redis
# client (cache, BullMQ, streams, leader-lock) discovers the master via
# Sentinel and follows failovers automatically. Leave unset for direct
# REDIS_HOST/REDIS_PORT.
# REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=

# Single active scheduler. On the `scheduler` role, when set to "true",
# replicas race for `lumi:scheduler:leader` (SET NX EX) before bringing up
# BullMQ; followers poll-block until the leader's TTL lapses. Default "false"
# relies on BullMQ's per-job locks (multiple schedulers are safe but wasteful).
# SCHEDULER_LEADER_LOCK=false
# SCHEDULER_LEADER_LOCK_TTL_MS=30000
# SCHEDULER_LEADER_LOCK_RENEW_MS=10000
# SCHEDULER_LEADER_LOCK_POLL_MS=2000

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Required. Docker Compose sets this automatically via the environment: block.
RABBITMQ_URL=amqp://lumi:lumi@localhost:5672
RABBITMQ_USER=lumi
RABBITMQ_PASSWORD=lumi

# ── Bot behaviour ─────────────────────────────────────────────────────────────
DEFAULT_PREFIX=,
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# pino output: `json` (prod) or `pretty` (local dev).
LOG_FORMAT=pretty
SENTRY_ENABLED=false
SENTRY_DSN=https://e95e5666c2cd1df4e47b4d9d406c803a@o4511430036357120.ingest.de.sentry.io/4511430050775120

# ── Telemetry ─────────────────────────────────────────────────────────────────
# Identifies the running service in logs/metrics/traces. Each app sets this for
# itself (apps/<svc>/src/service-name.ts) before bootstrap reads it.
# SERVICE_NAME=worker
SERVICE_VERSION=0.0.0
# OpenTelemetry tracing — only fully wired when the `observability` profile is up
# (otel-collector:4318). Set OTEL_ENABLED=false to disable entirely.
# IMPORTANT: do NOT enable OTEL_ENABLED and SENTRY_ENABLED at the same time — Sentry v10
# registers its own TracerProvider and will conflict.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLE_RATIO=1
# Prometheus /metrics. Each service exposes one HTTP listener on this port.
METRICS_ENABLED=true
METRICS_PORT=9090
# Grafana admin (only used by the observability profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Scalability ───────────────────────────────────────────────────────────────
# Define these to split the bot across multiple physical machines.
# SHARD_LIST=0,1,2
# TOTAL_SHARDS=10
# TOTAL_SHARDS=auto and unset both fall back to Discord's recommended count
# (GET /gateway/bot). The same call returns the session-start-limit; on boot
# we refuse to start if `remaining` is below the number of shards we'd need
# to IDENTIFY, so a crash loop can't burn the daily IDENTIFY budget and 401
# the bot. Set SHARD_IDENTIFY_FORCE=true to bypass that guard (will likely
# still fail — exists for emergency overrides only).
# SHARD_IDENTIFY_FORCE=false

# Redis-backed cluster coordinator. When set, multiple
# gateway (or monolith) replicas register in Redis, agree on a contiguous
# shard-range assignment, share an IDENTIFY throttler keyed by
# `shardId % max_concurrency`, and persist per-shard SessionInfo so the next
# process boot RESUMEs instead of IDENTIFYing. SHARD_LIST is ignored when
# CLUSTER_NAME is set — the coordinator owns the assignment.
# CLUSTER_NAME=lumi-prod
# Stable id for this replica; falls back to HOSTNAME / `<role>-<pid>`. Set
# this explicitly in StatefulSet-style deployments so the assignment is
# stable across restarts (less churn → more RESUMEs).
# LUMI_CONSUMER_ID=gw-0

# ── Event bus (gateway/worker split) ──────────────────────────────────────────
# `inproc` (default): in-process EventEmitter, single-process monolith path.
# `streams`: Redis Streams transport — required once the gateway and worker run
# in separate processes. Reads from REDIS_HOST/REDIS_PORT/REDIS_PASSWORD/REDIS_CACHE_DB.
# `nats`: NATS JetStream — for when Redis Streams saturates a single Redis CPU
# (>~20k evt/s sustained). Requires NATS_URL.
TRANSPORT=inproc
# NATS server URL(s). Required when TRANSPORT=nats. Comma-separated for cluster.
# NATS_URL=nats://nats:4222
# NATS_USER=
# NATS_PASSWORD=
# Approximate per-stream cap for raw gateway events (XADD MAXLEN ~).
EVENT_STREAM_MAXLEN=100000
# Backpressure + DLQ. After this many deliveries (initial + N claims),
# an entry is moved to <stream>:dlq and acked off the live stream.
EVENT_STREAM_MAX_DELIVERIES=5
# How long an entry must sit unacked before XAUTOCLAIM is eligible to steal it
# from a dead consumer. Set above your slowest legitimate handler latency.
EVENT_STREAM_CLAIM_MIN_IDLE_MS=60000
# How often each worker runs XAUTOCLAIM on its streams.
EVENT_STREAM_CLAIM_INTERVAL_MS=30000
# How often XLEN/XPENDING are reported to Prometheus (per stream).
EVENT_STREAM_STATS_INTERVAL_MS=10000

# ── Topology (gateway/worker split) ───────────────────────────────────────────
# `monolith` (default): single process holds the WS, runs all modules.
# `gateway`: WS-only service, publishes raw packets to the bus.
# `worker`: skips the WS, consumes raw packets from the bus, runs modules.
# Set automatically per-container under the `scale` compose profile.
LUMI_ROLE=monolith
# Stable per-replica id for the worker pool's consumer group. Defaults to
# $HOSTNAME (which compose/k8s set), then `worker-<pid>`. Override if you run
# multiple workers in one host or want sticky pending-claim across restarts.
# LUMI_CONSUMER_ID=worker-1
# Path (a): gateway pre-acks INTERACTION_CREATE via REST before publishing so
# Discord's 3s deadline doesn't include the bus hop. Worker patches Interaction
# methods so handlers' deferReply/deferUpdate calls become safe no-ops.
# Leave `false` to A/B test path (b) (worker is the sole acker).
INTERACTION_DEFER_AT_GATEWAY=false
# ── Shared REST proxy ────────────────────────────────────────────────────────
# Route all outbound discord.js REST through a shared proxy (we ship nirn-proxy
# in the `scale` compose profile). The proxy holds the authoritative per-route
# + global 50/s bucket budget for the *whole fleet* so 1000s of stateless
# workers can't compound into a CloudFlare ban. discord.js' local global
# throttle is automatically disabled when this is set (proxy is authoritative).
# Pass the proxy root (no `/api` suffix); empty/unset → talk to discord.com
# directly. The scale-profile services in docker-compose default this to
# `http://nirn-proxy:8080`.
# DISCORD_PROXY_URL=http://nirn-proxy:8080
# ── Cache TTL (seconds) ───────────────────────────────────────────────────────
LUMI_CACHE_TTL=60
