# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_client_id

# ── Owner IDs (comma-separated) ───────────────────────────────────────────────
OWNER_IDS=

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://ember:ember@localhost:5432/ember
POSTGRES_PASSWORD=ember

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# API Configuration
API_PORT=4000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ember
REDIS_CACHE_DB=0
REDIS_TASK_DB=1

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Required. Docker Compose sets this automatically via the environment: block.
RABBITMQ_URL=amqp://ember:ember@localhost:5672
RABBITMQ_USER=ember
RABBITMQ_PASSWORD=ember

# ── Bot behaviour ─────────────────────────────────────────────────────────────
DEFAULT_PREFIX=,
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_ENABLED=false
SENTRY_DSN=https://e95e5666c2cd1df4e47b4d9d406c803a@o4511430036357120.ingest.de.sentry.io/4511430050775120

# ── Scalability ───────────────────────────────────────────────────────────────
# Define these to split the bot across multiple physical machines.
# SHARD_LIST=0,1,2
# TOTAL_SHARDS=10
# ── Cache TTL (seconds) ───────────────────────────────────────────────────────
EMBER_CACHE_TTL=60
