# ── [ 1 ] MANDATORY CONFIGURATION ─────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_client_id

# Database
POSTGRES_URL=postgresql://lumi:lumi@localhost:5432/lumi
DIRECT_POSTGRES_URL=postgresql://lumi:lumi@localhost:5432/lumi
POSTGRES_PASSWORD=lumi
POSTGRES_POOL_MAX=10

# Redis & Event Bus
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=lumi
REDIS_CACHE_DB=0
REDIS_TASK_DB=1

# Internal RPC (dashboard -> worker HTTP bridge; RPC_HTTP_URL is read by the dashboard)
RPC_HTTP_HOST=0.0.0.0
RPC_HTTP_PORT=8091
RPC_HTTP_URL=http://localhost:8091


# ── [ 2 ] GENERAL SETTINGS ────────────────────────────────────────────────────
OWNER_IDS=
DEFAULT_PREFIX=,
NODE_ENV=development
LUMI_CACHE_TTL=60
# LUMI_DEV_PATHS=
# MODULE_UPDATE_AUTO_RESTART=true


# ── [ 3 ] LOGGING & TELEMETRY ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=pretty

# OpenTelemetry
SERVICE_VERSION=0.0.0
# SERVICE_NAME=worker
OTEL_ENABLED=false
# OTEL_DIAG=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLE_RATIO=1

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
# Running several services on one host off this file: give each its own port,
# otherwise they race for METRICS_PORT and all but the first lose /metrics.
# WORKER_METRICS_PORT=9090
# DASHBOARD_METRICS_PORT=9091
# SCHEDULER_METRICS_PORT=9092
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin


# ── [ 4 ] SCALABILITY & TOPOLOGY (ADVANCED) ───────────────────────────────────
# Roles: worker (Discord WS + all command/module logic), scheduler (BullMQ only)
LUMI_ROLE=worker
# LUMI_CONSUMER_ID=worker-1

# Sharding
# SHARD_LIST=0,1,2
# TOTAL_SHARDS=10
# SHARD_IDENTIFY_FORCE=false

# Cluster & Sentinels
# CLUSTER_NAME=lumi-prod
# REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=

EVENT_STREAM_MAXLEN=100000
EVENT_STREAM_MAX_DELIVERIES=5
EVENT_STREAM_CLAIM_MIN_IDLE_MS=60000
EVENT_STREAM_ACK_WAIT_MS=60000
EVENT_STREAM_CLAIM_INTERVAL_MS=30000
EVENT_STREAM_STATS_INTERVAL_MS=10000

# Scheduler
# SCHEDULER_LEADER_LOCK=false
# SCHEDULER_LEADER_LOCK_TTL_MS=30000
# SCHEDULER_LEADER_LOCK_RENEW_MS=10000
# SCHEDULER_LEADER_LOCK_POLL_MS=2000

# Caching & REST
# ENTITY_CACHE_POPULATE=false
# Shared Discord REST proxy (nirn-proxy). Multi-replica deployments only, where
# REST rate-limit buckets must be coordinated across worker processes. Leave
# unset for single-process runs - one worker tracks its own buckets correctly.
# DISCORD_PROXY_URL=http://nirn-proxy:8080


# ── [ 5 ] DASHBOARD CONFIGURATION ─────────────────────────────────────────────
# DASHBOARD_PORT=8080
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_SESSION_SECRET=openssl rand -hex 32
# DISCORD_OAUTH2_CLIENT_ID=
# DISCORD_OAUTH2_CLIENT_SECRET=
# There is no redirect-URI variable: NextAuth derives the callback from the
# request. Register <dashboard-origin>/api/auth/callback/discord under
# OAuth2 -> Redirects on your Discord application. Behind a proxy that
# rewrites the Host header, set AUTH_URL to the externally visible origin.
# AUTH_URL=https://lumi.example.com

# Public origin of the dashboard, read by the bot (not the dashboard) to build
# the ban/timeout appeal link it DMs. Unset means appeal links are skipped
# rather than DMed as a broken/relative URL - see packages/core/src/lib/appeals.
# DASHBOARD_PUBLIC_URL=https://lumi.example.com
# Signs the appeal link's token (HMAC-SHA256). Bot-only - the dashboard never
# reads this, it forwards the opaque token to the bot over RPC for verification.
# APPEAL_TOKEN_SECRET=openssl rand -hex 32
