# Required. Run `bun run setup` to fill these in and validate connectivity.
BOT_TOKEN=replace-me
OWNER_IDS=
DATABASE_URL=postgresql://lumi:lumi@127.0.0.1:5432/lumi
REDIS_URL=redis://localhost:6379/0
# Used by docker-compose; generated by `bun run setup` when missing.
POSTGRES_PASSWORD=
# Used by docker-compose; when set, keep it in sync with the password in REDIS_URL.
REDIS_PASSWORD=
# Shared secret for the dashboard -> bot RPC endpoints. docker-compose requires it.
RPC_INTERNAL_TOKEN=
# Prebuilt container image tag. Pin a release tag in production.
LUMI_TAG=latest
CACHE_NAMESPACE=lumi
LOG_LEVEL=info
METRICS_PORT=9090
DEFAULT_PREFIX=,
GIT_TOKEN=
GIT_USERNAME=x-access-token

# Dashboard (apps/dashboard)
# DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET come from the Discord developer portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:4173/auth/callback
# Base URL for web verification links (dashboard origin).
WEB_BASE_URL=http://localhost:4173
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=604800
