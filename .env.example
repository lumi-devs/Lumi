BOT_TOKEN=your_discord_bot_token_here
APPLICATION_ID=your_discord_application_id_here
APPEAL_TOKEN_SECRET=openssl rand -hex 32
OWNER_IDS=

POSTGRES_URL=postgresql://lumi:lumi@localhost:5432/lumi
DIRECT_POSTGRES_URL=postgresql://lumi:lumi@localhost:5432/lumi
POSTGRES_PASSWORD=lumi

VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGE_ME
VALKEY_CACHE_DB=0
VALKEY_TASK_DB=1

DEFAULT_PREFIX=,
NODE_ENV=development
LOG_LEVEL=info
DASHBOARD_PUBLIC_URL=http://localhost:8080

RPC_HTTP_URL=http://localhost:8091
RPC_INTERNAL_TOKEN=openssl rand -hex 32
DASHBOARD_SESSION_SECRET=openssl rand -hex 32
DISCORD_OAUTH2_CLIENT_ID=
DISCORD_OAUTH2_CLIENT_SECRET=

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Scale-out.
# POSTGRES_POOL_MAX: max Postgres connections (default 20).
# LUMI_DEV_PATHS: extra comma-separated module roots (dev only).
# POSTGRES_POOL_MAX=20
# LUMI_DEV_PATHS=
