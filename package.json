{
  "name": "ember",
  "version": "2.0.0",
  "description": "Ember — modular Discord bot (TypeScript / Sapphire / Postgres / Redis)",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "imports": {
    "#lib/commands.js": "./src/core/lib/commands.ts",
    "#lib/env.js": "./src/core/env.ts",
    "#lib/permissions.js": "./src/core/permissions/index.ts",
    "#lib/module-system.js": "./src/core/module-system/Module.ts",
    "#lib/rabbit.js": "./src/core/rabbitmq/index.ts",
    "#lib/types.js": "./src/core/types/common.ts",
    "#lib/guild-transaction.js": "./src/core/lib/guild-transaction.ts",
    "#database/*.js": "./src/database/*.ts",
    "#utilities/*.js": "./src/utilities/*.ts",
    "#workers/*.js": "./src/workers/*.ts",
    "#core/*.js": "./src/core/*.ts",
    "#root/*.js": "./src/*.ts",
    "#modules/*.js": "./src/modules/*.ts"
  },
  "scripts": {
    "dev": "rm -rf node_modules/.bin && bun install --frozen-lockfile && bun run db:generate && bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun --sourcemap=inline",
    "start:dist": "bun dist/main.js",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "lint": "eslint src --ext ts --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "clean": "rimraf dist/",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/bitfield": "^1.2.4",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/fetch": "^3.0.5",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/iterator-utilities": "^2.0.1",
    "@sapphire/plugin-api": "^8.3.1",
    "@sapphire/plugin-editable-commands": "^4.0.4",
    "@sapphire/plugin-i18next": "^8.0.0",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/plugin-scheduled-tasks": "^10.0.4",
    "@sapphire/plugin-subcommands": "^7.0.1",
    "@sapphire/ratelimits": "^2.4.11",
    "@sapphire/snowflake": "^3.5.5",
    "@sapphire/stopwatch": "^1.5.4",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/timestamp": "^1.0.5",
    "@sapphire/utilities": "^3.18.2",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "colorette": "^2.0.20",
    "discord.js": "^14.26.4",
    "i18next": "^26.2.0",
    "i18next-fs-backend": "^2.6.6",
    "ioredis": "^5.10.1",
    "pg": "^8.21.0",
    "sapphire-plugin-modal-commands": "^2.0.2",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sapphire/eslint-config": "^5.0.6",
    "@sapphire/ts-config": "^5.0.3",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
