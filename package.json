{
  "name": "lumi",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "Lumi - modular Discord bot (TypeScript / Sapphire / Postgres / Redis). Monorepo root.",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "comment:imports": "Safety net for downloaded addons: they are symlinked into packages/core/src/modules but live (realpath) under data/3rd-party-modules, so their #core/#lib/#utilities specifiers resolve up to THIS root package.json. Mirrors packages/core/package.json's imports map.",
  "comment:exports": "The public addon API, namespaced like redbot.core/redbot.core.commands/redbot.core.utils.chat_formatting. Since addon files' nearest package.json is this one (see comment:imports above), `import ... from \"lumi\"` (and its subpaths) self-resolve here via Node/Bun package self-reference - the one stable import surface third-party addon code should use instead of #core/#lib/#utilities/#database.",
  "exports": {
    ".": "./packages/core/src/lib/addon-sdk/index.ts",
    "./commands": "./packages/core/src/lib/addon-sdk/commands.ts",
    "./permissions": "./packages/core/src/lib/addon-sdk/permissions.ts",
    "./scheduling": "./packages/core/src/lib/addon-sdk/scheduling.ts",
    "./ui": "./packages/core/src/lib/addon-sdk/ui.ts",
    "./utils": "./packages/core/src/lib/addon-sdk/utils.ts"
  },
  "imports": {
    "#lib/commands.js": "./packages/core/src/lib/commands.ts",
    "#lib/env.js": "./packages/core/src/lib/env.ts",
    "#lib/permissions.js": "./packages/core/src/lib/permissions/index.ts",
    "#lib/module-system.js": "./packages/core/src/lib/module-system/Module.ts",
    "#lib/types.js": "./packages/core/src/lib/types/common.ts",
    "#lib/guild-transaction.js": "./packages/core/src/lib/guild-transaction.ts",
    "#lib/module-check.js": "./packages/core/src/lib/module-check.ts",
    "#lib/scheduler-bus.js": "./packages/core/src/lib/scheduler-bus.ts",
    "#lib/schedule-task.js": "./packages/core/src/lib/schedule-task.ts",
    "#lib/*.js": "./packages/core/src/lib/*.ts",
    "#database/*.js": "./packages/core/src/lib/database/*.ts",
    "#utilities/*.js": "./packages/core/src/lib/utilities/*.ts",
    "#core/lib/*.js": "./packages/core/src/lib/*.ts",
    "#core/module-system/*.js": "./packages/core/src/lib/module-system/*.ts",
    "#core/*.js": "./packages/core/src/lib/*.ts",
    "#root/*.js": "./packages/core/src/*.ts",
    "#modules/*.js": "./packages/core/src/modules/*.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "bun run --filter @lumi/worker start",
    "setup": "bash scripts/setup.sh",
    "typecheck": "turbo run typecheck:all && turbo run typecheck --filter=@lumi/dashboard && turbo run typecheck --filter=@lumi/docs",
    "lint": "turbo run lint:all",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "lint:all": "eslint packages/*/src apps/worker/src apps/dashboard/src --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun scripts/seed.ts",
    "modules:manifest": "bun scripts/generate-manifests.ts",
    "validate": "bun scripts/validate-addon.ts",
    "addon:create": "bun scripts/create-addon.ts",
    "test": "vitest run && bun run --cwd apps/dashboard test",
    "test:coverage": "vitest run --coverage && bun run --cwd apps/dashboard test -- --coverage",
    "changeset": "bunx @changesets/cli",
    "verify:resilience": "bun scripts/verify-resilience.ts",
    "bench": "bun scripts/benchmark.ts"
  },
  "devDependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^7.9.1",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/fetch": "^3.0.5",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/pieces": "^4.4.1",
    "@sapphire/plugin-editable-commands": "^4.0.4",
    "@sapphire/plugin-i18next": "^8.0.0",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/plugin-pattern-commands": "^6.0.3",
    "@sapphire/plugin-scheduled-tasks": "^10.0.4",
    "@sapphire/plugin-subcommands": "^7.0.1",
    "@sapphire/plugin-utilities-store": "^2.0.3",
    "@sapphire/ratelimits": "^2.4.11",
    "@sapphire/shapeshift": "^5.0.0",
    "@sapphire/snowflake": "^3.5.5",
    "@sapphire/stopwatch": "^1.5.4",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/utilities": "^3.18.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "discord-api-types": "^0.38.53",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "i18next": "^26.3.6",
    "prisma": "^7.9.1",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
