{
  "name": "lumi-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run dashboard:sync && vitest run",
    "test:watch": "bun run dashboard:sync && vitest",
    "test:coverage": "bun run dashboard:sync && vitest run --coverage",
    "setup": "bun run scripts/setup.ts",
    "setup:check": "bun run scripts/setup.ts --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "bun build src/index.ts --target=bun --external canvas --outdir=dist",
    "dev:bot": "bun --watch src/index.ts",
    "dashboard:dev": "bun run --cwd apps/dashboard dev",
    "dashboard:sync": "bun run --cwd apps/dashboard sync",
    "dashboard:build": "bun run --cwd apps/dashboard build",
    "dashboard:typecheck": "bun run --cwd apps/dashboard typecheck"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "discord.js": "^14.27.0",
    "ioredis": "^6.0.0",
    "isomorphic-git": "^1.44.12",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.4.4",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
