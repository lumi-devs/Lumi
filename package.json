{
  "name": "lumi",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "description": "Lumi - modular Discord bot (TypeScript / Sapphire / Postgres / Valkey). Monorepo root.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "lumi": "./apps/cli/src/main.ts"
  },
  "exports": {
    ".": "./packages/core/src/lib/addon-sandbox/sdk/index.ts",
    "./commands": "./packages/core/src/lib/addon-sandbox/sdk/commands.ts",
    "./config": "./packages/core/src/lib/addon-sandbox/sdk/config.ts",
    "./discord": "./packages/core/src/lib/addon-sandbox/sdk/discord.ts",
    "./interactions": "./packages/core/src/lib/addon-sandbox/sdk/interactions.ts",
    "./kv": "./packages/core/src/lib/addon-sandbox/sdk/kv.ts",
    "./permissions": "./packages/core/src/lib/addon-sandbox/sdk/permissions.ts",
    "./valkey": "./packages/core/src/lib/addon-sandbox/sdk/valkey.ts",
    "./scheduling": "./packages/core/src/lib/addon-sandbox/sdk/scheduling.ts",
    "./ui": "./packages/core/src/lib/addon-sandbox/sdk/ui.ts",
    "./utils": "./packages/core/src/lib/addon-sandbox/sdk/utils.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "bun run --filter @lumi/worker start",
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "turbo run lint:all",
    "lint:fix": "turbo run lint:all:fix",
    "lint:all": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint packages/*/src packages/core/tests apps/*/src apps/*/tests",
    "lint:all:fix": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint packages/*/src packages/core/tests apps/*/src apps/*/tests --fix",
    "knip": "knip",
    "db:generate": "prisma generate",
    "sdk:build": "bun run scripts/sdk/build.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun scripts/seed.ts",
    "modules:manifest": "bun packages/core/scripts/generate-manifests.ts",
    "validate": "bun packages/core/scripts/validate-addon.ts",
    "addon:create": "bun scripts/create-addon.ts",
    "test": "bun test --parallel --path-ignore-patterns '**/tests/integration/**' && bun run --cwd apps/api test && bun run --cwd apps/cli test",
    "test:coverage": "bun test --parallel --coverage --path-ignore-patterns '**/tests/integration/**' && bun run --cwd apps/api test -- --coverage && bun run --cwd apps/cli test -- --coverage",
    "test:integration": "bun test packages/*/tests/integration",
    "changeset": "changeset",
    "changeset:status": "changeset status --since main",
    "version-packages": "changeset version",
    "release-packages": "changeset publish",
    "verify:resilience": "bun packages/core/scripts/verify-resilience.ts",
    "bench": "bun packages/core/scripts/benchmark.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^7.10.0",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "discord-api-types": "^0.38.55",
    "dotenv": "^17.4.2",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.2",
    "knip": "6.36.0",
    "prisma": "^7.10.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0",
    "fast-uri": "^3.1.6",
    "mysql2": "^3.23.1"
  }
}
