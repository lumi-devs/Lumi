{
  "name": "@lumi-devs/lumi",
  "version": "0.6.4",
  "license": "AGPL-3.0-only",
  "description": "Lumi - modular Discord bot (TypeScript / discord.js / Postgres / Valkey). Monorepo root.",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumi-devs/lumi.git"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#src/*": "./src/*",
    "#lib/*.js": "./src/lib/*.ts",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": "./src/Index.ts",
    "./module": "./src/lib/module-system/Module.ts",
    "./commands": "./src/lib/commands/CommandDef.ts",
    "./context": "./src/lib/commands/Context.ts",
    "./listeners": "./src/lib/listeners/ListenerDef.ts",
    "./interactions": "./src/lib/interactions/InteractionDef.ts",
    "./ui": "./src/lib/ui/Cards.ts",
    "./config": "./src/lib/module-system/ConfigSchema.ts",
    "./api": "./src/lib/ModuleApi.ts",
    "./services": "./src/lib/Services.ts",
    "./scheduler": "./src/lib/scheduler/Oneshot.ts",
    "./bank": "./src/lib/api/economy/Bank.ts",
    "./time": "./src/lib/utilities/Time.ts",
    "./panels": "./src/lib/ui/Panels.ts",
    "./cooldown": "./src/lib/valkey/Cooldown.ts",
    "./lib/*": "./src/lib/*"
  },
  "files": [
    "src",
    "prisma",
    "tsconfig.base.json",
    "tsconfig.json",
    "prisma.config.ts",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "lumi": "./src/cli/Main.ts"
  },
  "scripts": {
    "start": "bun src/Index.ts",
    "dev": "bun --watch src/Index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "bun scripts/RunTests.ts",
    "test:coverage": "bun test --parallel --coverage tests/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "modules:manifest": "bun src/scripts/GenerateManifests.ts",
    "validate": "bun src/scripts/ValidateAddon.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "dotenv": "^17.4.2",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.2",
    "knip": "6.36.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "@prisma/adapter-pg": {
      "pg": "$pg"
    },
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0",
    "fast-uri": "^3.1.6",
    "mysql2": "^3.23.1"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/duration": "^1.2.0",
    "@sapphire/ratelimits": "^2.4.11",
    "@sapphire/snowflake": "^3.5.5",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/utilities": "^3.18.2",
    "ahocorasick": "^1.0.2",
    "bullmq": "^5.58.7",
    "cluster-key-slot": "^1.1.2",
    "discord-api-types": "^0.38.55",
    "discord.js": "^14.27.0",
    "i18next": "^26.4.2",
    "iovalkey": "^0.4.0",
    "isolated-vm": "^7.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "zod": "^4",
    "@lumi-devs/lumi": "file:."
  }
}
