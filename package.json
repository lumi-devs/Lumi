{
  "name": "lumi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": ["apps/*", "modules", "packages/*"],
    "catalog": {
      "@discordjs/builders": "^1.14.1",
      "@discordjs/formatters": "^0.6.2",
      "@prisma/adapter-pg": "^7.10.0",
      "@prisma/client": "^7.10.0",
      "@prisma/client-runtime-utils": "^7.10.0",
      "@sapphire/utilities": "^3.18.2",
      "@types/bun": "^1.4.1",
      "@types/node": "^26.4.1",
      "@types/pg": "^8.23.1",
      "devalue": "^5.3.2",
      "discord.js": "^14.27.0",
      "ioredis": "^5.9.2",
      "pg": "^8.23.0",
      "pino": "^10.3.1",
      "prisma": "^7.10.0",
      "prom-client": "^15.1.3",
      "typescript": "^6.0.3",
      "zod": "^4.1.0"
    }
  },
  "scripts": {
    "dev": "bun --watch apps/bot/src/index.ts",
    "start": "bun apps/bot/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --isolate",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@discordjs/builders": "catalog:",
    "@discordjs/formatters": "catalog:",
    "@lumi/module-kit": "workspace:*",
    "@lumi/foundation": "workspace:*",
    "@lumi/ui": "workspace:*",
    "@sapphire/utilities": "catalog:",
    "discord.js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
