{
  "name": "lumi",
  "version": "2.1.1",
  "license": "Apache-2.0",
  "description": "Lumi — modular Discord bot (TypeScript / Sapphire / Postgres / Redis). Monorepo root.",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "comment:imports": "Safety net for downloaded addons: they are symlinked into packages/core/src/modules but live (realpath) under data/3rd-party-modules, so their #core/#lib/#utilities specifiers resolve up to THIS root package.json. Mirrors packages/core/package.json's imports map.",
  "imports": {
    "#lib/commands.js": "./packages/core/src/core/lib/commands.ts",
    "#lib/env.js": "./packages/core/src/core/env.ts",
    "#lib/permissions.js": "./packages/core/src/core/permissions/index.ts",
    "#lib/module-system.js": "./packages/core/src/core/module-system/Module.ts",
    "#lib/rabbit.js": "./packages/core/src/core/rabbitmq/index.ts",
    "#lib/types.js": "./packages/core/src/core/types/common.ts",
    "#lib/guild-transaction.js": "./packages/core/src/core/lib/guild-transaction.ts",
    "#database/*.js": "./packages/core/src/database/*.ts",
    "#utilities/*.js": "./packages/core/src/utilities/*.ts",
    "#workers/*.js": "./packages/core/src/workers/*.ts",
    "#core/*.js": "./packages/core/src/core/*.ts",
    "#root/*.js": "./packages/core/src/*.ts",
    "#modules/*.js": "./packages/core/src/modules/*.ts",
    "#lib/module-check.js": "./packages/core/src/core/lib/module-check.ts"
  },
  "scripts": {
    "dev": "bun install && bun run db:generate && bun --filter @lumi/worker run dev",
    "start": "bun --filter @lumi/worker run start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint packages/*/src apps/*/src --ext ts --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "modules:manifest": "bun scripts/generate-manifests.ts",
    "test": "vitest run",
    "verify:chaos": "bun scripts/verify-chaos.ts",
    "verify:chaos:nats": "WITH_NATS=1 bun scripts/verify-chaos.ts"
  },
  "devDependencies": {
    "@sapphire/eslint-config": "^5.0.6",
    "@sapphire/ts-config": "^5.0.3",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "prisma": "^7.8.0",
    "typescript": "~5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
