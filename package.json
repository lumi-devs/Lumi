{
  "name": "lumi",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "description": "Lumi — modular Discord bot (TypeScript / Sapphire / Postgres / Redis). Monorepo root.",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "comment:imports": "Safety net for downloaded addons: they are symlinked into packages/core/src/modules but live (realpath) under data/3rd-party-modules, so their #core/#lib/#utilities specifiers resolve up to THIS root package.json. Mirrors packages/core/package.json's imports map.",
  "imports": {
    "#lib/commands.js": "./packages/core/src/lib/commands.ts",
    "#lib/env.js": "./packages/core/src/lib/env.ts",
    "#lib/permissions.js": "./packages/core/src/lib/permissions/index.ts",
    "#lib/module-system.js": "./packages/core/src/lib/module-system/Module.ts",
    "#lib/rabbit.js": "./packages/core/src/lib/rabbitmq/index.ts",
    "#lib/types.js": "./packages/core/src/lib/types/common.ts",
    "#lib/guild-transaction.js": "./packages/core/src/lib/guild-transaction.ts",
    "#lib/module-check.js": "./packages/core/src/lib/module-check.ts",
    "#lib/scheduler-bus.js": "./packages/core/src/lib/scheduler-bus.ts",
    "#lib/schedule-task.js": "./packages/core/src/lib/schedule-task.ts",
    "#lib/*.js": "./packages/core/src/lib/*.ts",
    "#database/*.js": "./packages/core/src/lib/database/*.ts",
    "#utilities/*.js": "./packages/core/src/lib/utilities/*.ts",
    "#core/lib/*.js": "./packages/core/src/lib/*.ts",
    "#core/module-system/*.js": "./packages/core/src/lib/module-system/*.ts",
    "#core/*.js": "./packages/core/src/lib/*.ts",
    "#root/*.js": "./packages/core/src/*.ts",
    "#modules/*.js": "./packages/core/src/modules/*.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "bun --filter @lumi/worker run start",
    "typecheck": "turbo run typecheck:all",
    "lint": "turbo run lint:all",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "lint:all": "eslint packages/*/src apps/*/src --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "modules:manifest": "bun scripts/generate-manifests.ts",
    "validate": "bun scripts/validate-addon.ts",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "verify:resilience": "bun scripts/verify-resilience.ts"
  },
  "overrides": {
    "@opentelemetry/semantic-conventions": "1.42.0"
  },
  "devDependencies": {
    "@discordjs/builders": "*",
    "@discordjs/formatters": "*",
    "@discordjs/rest": "*",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@sapphire/async-queue": "*",
    "@sapphire/decorators": "*",
    "@sapphire/discord.js-utilities": "*",
    "@sapphire/fetch": "*",
    "@sapphire/framework": "*",
    "@sapphire/pieces": "*",
    "@sapphire/plugin-editable-commands": "*",
    "@sapphire/plugin-i18next": "*",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/plugin-pattern-commands": "*",
    "@sapphire/plugin-scheduled-tasks": "*",
    "@sapphire/plugin-subcommands": "*",
    "@sapphire/plugin-utilities-store": "*",
    "@sapphire/ratelimits": "*",
    "@sapphire/shapeshift": "*",
    "@sapphire/snowflake": "*",
    "@sapphire/stopwatch": "*",
    "@sapphire/time-utilities": "*",
    "@sapphire/timestamp": "*",
    "@sapphire/ts-config": "^5.0.3",
    "@sapphire/utilities": "*",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "amqp-connection-manager": "*",
    "discord-api-types": "^0.38.50",
    "discord.js": "*",
    "dotenv": "*",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "i18next": "*",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0",
    "turbo": "^2.10.3",
    "typescript": "5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
