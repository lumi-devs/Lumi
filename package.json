{
  "name": "lumi",
  "version": "0.3.0",
  "license": "GPL-3.0-only",
  "description": "Lumi - modular Discord bot (TypeScript / Sapphire / Postgres / Redis). Monorepo root.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "comment:imports": "Internal specifiers for this repo's own code. Addons no longer resolve against this file: an installed addon's nearest package.json is the one AddonHost writes to data/3rd-party-modules, which maps `lumi` and nothing else - so #lib/#database/#utilities do not resolve from addon source at all.",
  "comment:exports": "The addon API. Addon code runs in its own process (packages/core/src/lib/addon-sandbox) with no bot token, database URL or Redis URL, and reaches the bot only through these subpaths. This map is mirrored at runtime into data/3rd-party-modules/package.json; it lives here too so examples/ and repo tooling resolve the same surface an installed addon gets.",
  "exports": {
    ".": "./packages/core/src/lib/addon-sandbox/sdk/index.ts",
    "./commands": "./packages/core/src/lib/addon-sandbox/sdk/commands.ts",
    "./config": "./packages/core/src/lib/addon-sandbox/sdk/config.ts",
    "./discord": "./packages/core/src/lib/addon-sandbox/sdk/discord.ts",
    "./interactions": "./packages/core/src/lib/addon-sandbox/sdk/interactions.ts",
    "./kv": "./packages/core/src/lib/addon-sandbox/sdk/kv.ts",
    "./permissions": "./packages/core/src/lib/addon-sandbox/sdk/permissions.ts",
    "./redis": "./packages/core/src/lib/addon-sandbox/sdk/redis.ts",
    "./scheduling": "./packages/core/src/lib/addon-sandbox/sdk/scheduling.ts",
    "./ui": "./packages/core/src/lib/addon-sandbox/sdk/ui.ts",
    "./utils": "./packages/core/src/lib/addon-sandbox/sdk/utils.ts"
  },
  "imports": {
    "#lib/commands.js": "./packages/core/src/lib/commands.ts",
    "#lib/env.js": "./packages/core/src/lib/env.ts",
    "#lib/permissions.js": "./packages/core/src/lib/permissions/index.ts",
    "#lib/module-system.js": "./packages/core/src/lib/module-system/Module.ts",
    "#lib/types.js": "./packages/core/src/lib/types/common.ts",
    "#lib/guild-transaction.js": "./packages/core/src/lib/guild-transaction.ts",
    "#lib/module-check.js": "./packages/core/src/lib/module-check.ts",
    "#lib/scheduler-bus.js": "./packages/core/src/lib/scheduler-bus.ts",
    "#lib/schedule-task.js": "./packages/core/src/lib/schedule-task.ts",
    "#lib/*.js": "./packages/core/src/lib/*.ts",
    "#database/*.js": "./packages/core/src/lib/database/*.ts",
    "#utilities/*.js": "./packages/core/src/lib/utilities/*.ts",
    "#root/*.js": "./packages/core/src/*.ts",
    "#modules/*.js": "./packages/core/src/modules/*.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "bun run --filter @lumi/worker start",
    "setup": "bash scripts/setup.sh",
    "typecheck": "turbo run typecheck:all && turbo run typecheck --filter=@lumi/dashboard && turbo run typecheck --filter=@lumi/docs",
    "lint": "turbo run lint:all",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "lint:all": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint packages/*/src apps/worker/src apps/dashboard/src apps/docs/src --fix",
    "knip": "knip",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun scripts/seed.ts",
    "modules:manifest": "bun scripts/generate-manifests.ts",
    "validate": "bun scripts/validate-addon.ts",
    "addon:create": "bun scripts/create-addon.ts",
    "test": "bun test --parallel && bun run --cwd apps/dashboard test",
    "test:coverage": "bun test --parallel --coverage && bun run --cwd apps/dashboard test -- --coverage",
    "changeset": "bunx @changesets/cli",
    "version:sync": "bunx @changesets/cli version && bun run modules:manifest",
    "verify:resilience": "bun scripts/verify-resilience.ts",
    "bench": "bun scripts/benchmark.ts"
  },
  "devDependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^7.10.0",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/fetch": "^3.0.5",
    "@sapphire/framework": "^5.5.1",
    "@sapphire/pieces": "^4.4.1",
    "@sapphire/plugin-editable-commands": "^4.0.4",
    "@sapphire/plugin-i18next": "^8.0.0",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/plugin-pattern-commands": "^6.0.3",
    "@sapphire/plugin-scheduled-tasks": "^10.0.4",
    "@sapphire/plugin-subcommands": "^7.0.1",
    "@sapphire/plugin-utilities-store": "^2.0.3",
    "@sapphire/ratelimits": "^2.4.11",
    "@sapphire/shapeshift": "^5.0.0",
    "@sapphire/snowflake": "^3.5.5",
    "@sapphire/stopwatch": "^1.5.4",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/utilities": "^3.18.2",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "discord-api-types": "^0.38.55",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "i18next": "^26.4.2",
    "knip": "6.34.0",
    "prisma": "^7.10.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0",
    "fast-uri": "^3.1.6",
    "mysql2": "^3.23.1"
  }
}
