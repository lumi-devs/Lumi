{
  "name": "lumi-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*",
    "apps/bot/src/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "build": "tsc -b",
    "dev:bot": "bun --watch apps/bot/src/index.ts"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "devalue": "^5.0.0",
    "discord.js": "^14.14.0",
    "ioredis": "^5.3.2",
    "pino": "^8.19.0",
    "prom-client": "^15.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "@vitest/coverage-v8": "^1.3.0",
    "prisma": "^7.10.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.1.0"
}
