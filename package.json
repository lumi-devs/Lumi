{
  "name": "lumi-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cd apps/dashboard && ./node_modules/.bin/svelte-kit sync && cd ../.. && vitest run",
    "test:watch": "cd apps/dashboard && ./node_modules/.bin/svelte-kit sync && cd ../.. && vitest",
    "test:coverage": "cd apps/dashboard && ./node_modules/.bin/svelte-kit sync && cd ../.. && vitest run --coverage",
    "setup": "bun run scripts/setup.ts",
    "setup:check": "bun run scripts/setup.ts --check",
    "db:studio": "prisma studio",
    "seed": "bun run scripts/seed.ts",
    "build": "bun build src/index.ts --target=bun --external canvas --outdir=dist",
    "docker:build": "docker build --format docker -t lumi-bot:latest -f Dockerfile . && docker build --format docker -t lumi-dashboard:latest -f apps/dashboard/Dockerfile .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "dev:bot": "bun --watch src/index.ts",
    "dashboard:dev": "cd apps/dashboard && ./node_modules/.bin/vite dev --host 0.0.0.0 --port 4173",
    "dashboard:sync": "cd apps/dashboard && ./node_modules/.bin/svelte-kit sync",
    "dashboard:build": "cd apps/dashboard && ./node_modules/.bin/vite build",
    "dashboard:typecheck": "cd apps/dashboard && ./node_modules/.bin/svelte-kit sync && ./node_modules/.bin/svelte-check --tsconfig ./tsconfig.json && ./node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "discord.js": "^14.27.0",
    "ioredis": "^6.0.0",
    "isomorphic-git": "^1.44.12",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.4.4",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "overrides": {
    "effect": "^3.22.1"
  },
  "packageManager": "bun@1.4.4"
}
